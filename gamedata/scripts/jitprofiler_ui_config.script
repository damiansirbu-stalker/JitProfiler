--- jitprofiler_ui_config: the JitProfiler footer -- the capture Settings, the Anonymize keep-set editor, and the masked-page save.

local ImGui, ImGuiCol = ImGui, ImGuiCol
local floor, min, tostring = math.floor, math.min, tostring
local sformat, concat = string.format, table.concat
local vector2, fcolor = vector2, fcolor

local COLOR_DIM = fcolor():set(0.22, 0.24, 0.28, 1.0)
local FILTER_W  = 180
local VZERO     = vector2(0, 0)
local BTN_SIZE  = vector2(96, 0)
-- Readable-owners preview: names shown in full before the "+N more" tail.
local READABLE_SHOWN = 3

local keep_input = ""
local save_status = ""

-- One line of text in a pushed colour, popped after: the panel's most repeated idiom.
local function render_colored_text(color, text)
    ImGui.PushStyleColor(ImGuiCol.Text, color)
    ImGui.Text(text)
    ImGui.PopStyleColor(1)
end

-- One integer capture setting as a whole-number slider, written back to the session state on change.
local function render_int_setting(key, label, low, high)
    local changed, value = ImGui.SliderFloat(label, JitProfiler.get_setting(key), low, high, "%.0f")
    if changed then JitProfiler.set_setting(key, floor(value + 0.5)) end
end

local function render_settings()
    if not ImGui.CollapsingHeader("Settings") then return end
    render_int_setting("interval", "CPU interval (ms)", 1, 20)
    render_int_setting("depth", "Stack depth", 4, 64)
    render_int_setting("auto_snap", "Auto-snapshot at (%)", 50, 99)
    render_int_setting("duration", "Auto-stop after (s)", 0, 600)
end

-- Each kept entry as a row: an x that removes it, then the entry text.
local function render_keep_list(list)
    for i = 1, #list do
        local entry = list[i]
        if ImGui.Button("x##keep" .. entry, VZERO) then JitProfiler.remove_keep(entry) end
        ImGui.SameLine()
        ImGui.Text(entry)
    end
end

-- Anonymize: the session toggle plus the persisted keep-set editor; masking is global, so it sits in the footer, not the sampling controls.
local function render_anonymize()
    if not ImGui.CollapsingHeader("Anonymize") then return end
    local anon = JitProfiler.get_setting("anon") and true or false
    local _, new_anon = ImGui.Checkbox("Anonymize names", anon)
    if new_anon ~= anon then JitProfiler.set_setting("anon", new_anon) end
    render_colored_text(COLOR_DIM, "Masks mod and mod-owned script names in the panel and every export; kept names stay readable.")
    ImGui.SetNextItemWidth(FILTER_W)
    local new_input = ImGui.InputText("##keep", keep_input, 64)
    if ImGui.IsItemHovered() then
        ImGui.SetTooltip(
            "Keep readable: type your mod's name, case-insensitive.\n" ..
            "It keeps that mod and all its scripts; every other mod name masks.\n" ..
            "At least 3 letters, matched from the start of the name.\n" ..
            "A Lua pattern, not a glob -- * is not a wildcard.")
    end
    if new_input then keep_input = new_input end
    ImGui.SameLine()
    if ImGui.Button("Keep##add", VZERO) then
        JitProfiler.add_keep(keep_input)
        keep_input = ""
    end
    local list = JitProfiler.get_keep_list()
    if #list == 0 then
        render_colored_text(COLOR_DIM, "nothing kept; every mod name masks when Anonymize is on")
    else
        render_keep_list(list)
    end
end

-- The masking blast radius: which mod names the keep-set leaves readable on the saved page.
local function render_readable_line()
    local readable = JitProfiler.get_readable_owners()
    if #readable == 0 then
        render_colored_text(COLOR_DIM, "readable on the page: none; every mod name masks")
        return
    end
    local names = {}
    for i = 1, min(#readable, READABLE_SHOWN) do
        names[i] = (readable[i]:gsub("^mod: ", ""):gsub("^loose: ", ""))
    end
    local extra = #readable > READABLE_SHOWN and sformat(" +%d more", #readable - READABLE_SHOWN) or ""
    render_colored_text(COLOR_DIM, "readable on the page: " .. concat(names, ", ") .. extra)
end

-- Save the retained captures as one masked page to the logs folder; the user commits it to the mod's pages/jitprofiler.html by hand.
local function render_save_page()
    if not ImGui.CollapsingHeader("Save page") then return end
    if ImGui.Button("Save page##save", BTN_SIZE) then
        local res = JitProfiler.save_page()
        if res.ok then save_status = "saved: " .. tostring(res.path)
        else save_status = "failed: " .. tostring(res.reason or "?") end
    end
    ImGui.SameLine()
    render_colored_text(COLOR_DIM, save_status ~= "" and save_status or "writes the masked page to appdata/logs")
    render_readable_line()
end

--- Draw the panel footer under the profiling tabs: the capture Settings, the Anonymize keep-set, and the masked-page save.
function render_footer()
    render_settings()
    render_anonymize()
    render_save_page()
end
