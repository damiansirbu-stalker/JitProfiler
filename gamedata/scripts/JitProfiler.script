--- JitProfiler: engine-native LuaJIT sampling profiler over jit.profile/jit.allocprof; usage in doc/readme.txt.

local CPU_INTERVAL_MS     = 5
local DEFAULT_STACK_DEPTH = 64
local CPU_MAX_STACKS      = 50000
local TOP_N               = 40
local AUTO_SNAP_PCT       = 90
local BAR_WIDTH           = 20
local BYTES_PER_MB        = 1048576
local BYTES_PER_KB        = 1024
local OWNER_ANOMALY       = "anomaly"
local OWNER_UNKNOWN       = "unknown"
local OWNER_ENGINE        = "engine"
local OWNER_MODDED        = "modded exes"
local OWNER_MOD           = "mod: "

local string, table, math, pairs, ipairs = string, table, math, pairs, ipairs
local pcall, tostring, tonumber, require, io, os = pcall, tostring, tonumber, require, io, os
local format = string.format
local getFS, time_global, jit = getFS, time_global, jit
local RegisterScriptCallback = RegisterScriptCallback
local rawget, rawset = rawget, rawset

-- Per-sample VM state from jit.profile: what the VM was doing when the timer fired.
local VMSTATE = {
    N = "JIT-compiled (native)",
    I = "interpreter",
    C = "C / engine call",
    G = "garbage collector",
    J = "JIT compiler",
}
local VMORDER = { "N", "I", "C", "G", "J" }

-- Callback-dispatch machinery, matched by leaf name to split framework cost from real handler work.
local DISPATCH = {
    make_callback = true, SendScriptCallback = true, callback = true,
    callback_set = true, callback_unset = true, spairs = true,
}

-- xlog resolves at call time: JitProfiler evaluates before xlibs, so the logger is built on first use.
local log_handle
local function log(fmt, ...)
    if not log_handle then
        log_handle = xlog.get_logger("JitProfiler", { outfile = "jitprofiler.log", level = "INFO" })
    end
    log_handle.info(fmt, ...)
end

--- @safety SAFE - require() of an optional module runs under pcall; a missing module yields nil for the guard below.
local function find_module(name)
    local ok, module = pcall(require, name)
    return ok and module or nil
end

-- On a stock exe the primitives are absent, so report it and stub the commands as no-ops.
local profile   = find_module("jit.profile")
local allocprof = find_module("jit.allocprof")
if not (profile and allocprof) then
    local function log_absent() log("!JitProfiler: this exe lacks jit.profile/jit.allocprof; it needs a demonized profiler build.") end
    start_cpu, stop_cpu, start_alloc, stop_alloc, write_snapshot, set_fold_anomaly = log_absent, log_absent, log_absent, log_absent, log_absent, log_absent
    is_cpu_active = function() return false end
    is_mem_active = function() return false end
    get_capture_progress = function() return nil end
    get_last_capture = function() return nil end
    get_owner = function() return OWNER_UNKNOWN end
    get_owner_label = function() return OWNER_UNKNOWN end
    get_setting = function() return 0 end
    set_setting = function() end
    compute_neighbors = function() return nil end
    return
end

local function build_log_path(name)
    local base = getFS():update_path("$logs$", "")
    return (base or "") .. name
end

local function write_lines(path, lines)
    local file = io.open(path, "w")
    if not file then log("!JitProfiler: cannot write %s", tostring(path)); return nil end
    for i = 1, #lines do file:write(lines[i]); file:write("\n") end
    file:close()
    return path
end

local function show_tip(msg)
    if db and db.actor then news_manager.send_tip(db.actor, msg, nil, nil, 4000) end
end

local function get_time_ms()
    return (time_global and time_global()) or 0
end

local function get_timestamp()
    return os.date("%Y%m%d_%H%M%S")
end

-- Reduce a frame to name@script:line, pulling the basename cleanly out of a truncated short_src.
-- On a truncated frame with no file token, return it unchanged: it already carries name@..., so prepending would double the name.
local function get_short_frame(frame)
    local file = frame:match("([%w_%.%-]+%.script:%-?%d+)")
              or frame:match("([%w_%.%-]+%.lua:%-?%d+)")
              or frame:match("(%[C%]:%-?%d+)")
    if not file then return frame end
    local name = frame:match("^([%w_]+)@")
    return name and (name .. "@" .. file) or file
end

-- Reduce a frame to its script file for the by-script rollup.
local function get_frame_script(frame)
    return (get_short_frame(frame):match("([%w_%.%-]+%.script)")) or get_short_frame(frame)
end

-- Leaf function name for the framework-vs-handler match.
local function get_leaf_name(frame)
    return frame:match("^([%w_]+)@") or ""
end

local function format_bytes(value)
    if value >= BYTES_PER_MB then return format("%.1f MB", value / BYTES_PER_MB) end
    if value >= BYTES_PER_KB then return format("%.1f KB", value / BYTES_PER_KB) end
    return format("%.0f B", value)
end
local function format_count(value) return format("%d", value) end

-- ASCII percentage bar that renders in any editor and encoding.
local function build_bar(percent)
    local fill = math.floor((percent / 100) * BAR_WIDTH + 0.5)
    if fill > BAR_WIDTH then fill = BAR_WIDTH elseif fill < 0 then fill = 0 end
    return "[" .. string.rep("#", fill) .. string.rep(" ", BAR_WIDTH - fill) .. "]"
end

-- Reverse a leaf-first stack into the root-first order SpeedScope .folded expects.
local function build_folded_stack(stack)
    local parts, count = {}, 0
    for frame in string.gmatch(stack, "[^;]+") do count = count + 1; parts[count] = get_short_frame(frame) end
    local out = {}
    for i = count, 1, -1 do out[#out + 1] = parts[i] end
    return table.concat(out, ";")
end

-- Per-mod origin resolver: the owning mod from the file's real backing path via MO2/USVFS.
local origin_cache = {}
local resolve_ready = false
local fold_override
local ffi, k32

-- Session capture settings, anchored to _G so the two chunk generations share one table. Edited from the panel, never persisted.
local settings = rawget(_G, "__jitprofiler_settings")
if not settings then
    settings = { interval = CPU_INTERVAL_MS, depth = DEFAULT_STACK_DEPTH, top_n = TOP_N,
                 auto_snap = AUTO_SNAP_PCT, duration = 0, fold = false }
    rawset(_G, "__jitprofiler_settings", settings)
end

--- @safety SAFE - each optional FFI step runs under pcall; any failure leaves resolve_ready false and owners unknown.
local function init_ffi()
    local ok_ffi, module = pcall(require, "ffi")
    if not (ok_ffi and module) then return end
    local ok_decl = pcall(module.cdef, [[
        void* __stdcall CreateFileA(const char*, unsigned long, unsigned long, void*, unsigned long, unsigned long, void*);
        unsigned long __stdcall GetFinalPathNameByHandleA(void*, char*, unsigned long, unsigned long);
        int __stdcall CloseHandle(void*);
    ]])
    if not ok_decl then return end
    local ok_load, lib = pcall(module.load, "kernel32")
    if not ok_load then return end
    ffi, k32, resolve_ready = module, lib, true
end
init_ffi()

-- Real backing path of a virtual script path via the OS handle; nil when the open fails (packed base db0).
local function resolve_real_path(vpath)
    local invalid = ffi.cast("void*", -1)
    local handle = k32.CreateFileA(vpath, 0x80000000, 0x1, nil, 3, 0, nil)
    if handle == invalid or handle == nil then return nil end
    local buffer = ffi.new("char[?]", 1024)
    local written = k32.GetFinalPathNameByHandleA(handle, buffer, 1024, 0)
    k32.CloseHandle(handle)
    return (written > 0) and ffi.string(buffer) or nil
end

-- Owner from the winning mod (real backing path), then the baked name sets: demonized overlay, stock Anomaly, else unknown.
--- @safety SAFE - pcall contains any FFI error to a nil path, so an unresolved script falls through to the name sets.
local function get_script_owner(script_file)
    if not script_file or script_file == "" then return OWNER_UNKNOWN end
    if origin_cache[script_file] then return origin_cache[script_file] end
    local owner
    if resolve_ready then
        local ok, real = pcall(resolve_real_path, getFS():update_path("$game_scripts$", script_file))
        local mod = ok and real and real:match("[\\/][Mm][Oo][Dd][Ss][\\/]([^\\/]+)")
        if mod then owner = OWNER_MOD .. mod end
    end
    if not owner then
        if jitprofiler_names.is_modded_exes(script_file) then owner = OWNER_MODDED
        elseif jitprofiler_names.is_vanilla(script_file) then owner = OWNER_ANOMALY
        else owner = OWNER_UNKNOWN end
    end
    origin_cache[script_file] = owner
    return owner
end

local function sort_entries(map)
    local entries = {}
    for key, weight in pairs(map) do entries[#entries + 1] = { key, weight } end
    table.sort(entries, function(left, right) return left[2] > right[2] end)
    return entries
end

local function compute_pct(value, total) return total > 0 and (100.0 * value / total) or 0 end

-- Append a ranked top-N view; opts.owned resolves each row's mod and honours the report fold.
local function build_view(lines, title, map, total, fmt, opts)
    local owned = opts and opts.owned
    local top_n = settings.top_n
    local fold = fold_override
    if fold == nil then fold = settings.fold and true or false end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- " .. title .. " " .. string.rep("-", math.max(2, 68 - #title))
    local entries = sort_entries(map)
    local shown, skipped = 0, 0
    for i = 1, #entries do
        if shown >= top_n then break end
        local key, weight = entries[i][1], entries[i][2]
        local owner = owned and get_owner(key) or nil
        if owned and fold and owner == OWNER_ANOMALY then
            skipped = skipped + 1
        else
            local percent = compute_pct(weight, total)
            local label = owner and format("%-18s %s", get_owner_label(key), key) or key
            lines[#lines + 1] = format("  %6.2f%% %s %12s  %s", percent, build_bar(percent), fmt(weight), label)
            shown = shown + 1
        end
    end
    local rest = #entries - shown - skipped
    if rest > 0 then lines[#lines + 1] = format("  ... %d more rows", rest) end
    if skipped > 0 then lines[#lines + 1] = format("  (%d anomaly rows folded)", skipped) end
end

-- Split the leaf frame into callback-dispatch overhead versus real handler work.
local function get_stack_bucket(leaf_frame)
    return DISPATCH[get_leaf_name(leaf_frame)] and "[framework] callback dispatch" or "[handlers] mod + engine work"
end

-- Credit one captured stack into every ranked map and update the depth stats.
local function collect_stack(v, stack, weight, cap)
    local first, last, nframes = nil, nil, 0
    local seen_owner, seen_script = {}, {}
    for frame in string.gmatch(stack, "[^;]+") do
        if not first then first = frame end
        last = frame
        nframes = nframes + 1
        seen_owner[get_owner(frame)] = true
        seen_script[get_frame_script(frame)] = true
    end
    first, last = first or "?", last or "?"
    local leaf_key = get_short_frame(first)
    local script_file = get_frame_script(first)
    local owner = get_script_owner(script_file)
    v.leaf[leaf_key]              = (v.leaf[leaf_key] or 0) + weight
    v.by_script[script_file]      = (v.by_script[script_file] or 0) + weight
    v.root[get_short_frame(last)] = (v.root[get_short_frame(last)] or 0) + weight
    v.by_mod[owner]               = (v.by_mod[owner] or 0) + weight
    for owner_key in pairs(seen_owner) do v.by_mod_total[owner_key] = (v.by_mod_total[owner_key] or 0) + weight end
    for script_key in pairs(seen_script) do v.by_script_total[script_key] = (v.by_script_total[script_key] or 0) + weight end
    if nframes > v.max_depth then v.max_depth = nframes end
    if cap and nframes >= cap then v.clipped = v.clipped + weight end
    local bucket = get_stack_bucket(first)
    v.framework[bucket]           = (v.framework[bucket] or 0) + weight
end

-- Own (innermost, exclusive) and Total (any frame, inclusive) maps per mod and per script, plus root, framework, and depth stats.
local function compute_views(by_stack, cap)
    local v = { leaf = {}, by_script = {}, root = {}, framework = {},
                by_mod = {}, by_mod_total = {}, by_script_total = {}, max_depth = 0, clipped = 0 }
    for stack, weight in pairs(by_stack) do collect_stack(v, stack, weight, cap) end
    return v
end

local function get_key_count(map)
    local count = 0
    for _ in pairs(map) do count = count + 1 end
    return count
end

local function write_folded(kind, by_stack)
    local folded = {}
    for stack, weight in pairs(by_stack) do folded[#folded + 1] = build_folded_stack(stack) .. " " .. format("%.0f", weight) end
    return write_lines(build_log_path("jitprofiler_" .. kind .. ".folded"), folded)
end

-- Forward-declared so the CPU and allocation profilers can see each other and stay mutually exclusive.
local alloc

local cpu = { stacks = {}, state = {}, total = 0, nstacks = 0, dropped = 0, iv = CPU_INTERVAL_MS, depth = DEFAULT_STACK_DEPTH, t0 = 0, limit = 0, active = false }

-- The most recent CPU and allocation capture, retained for the in-game panel to render.
local last_capture = rawget(_G, "__jitprofiler_capture")
if not last_capture then
    last_capture = { cpu = nil, mem = nil }
    rawset(_G, "__jitprofiler_capture", last_capture)
end

local function collect_cpu_sample(thread, count, vmstate)
    local stack = profile.dumpstack(thread, "", cpu.depth)
    if stack and stack ~= "" then
        local current = cpu.stacks[stack]
        if current then
            cpu.stacks[stack] = current + count
        elseif cpu.nstacks < CPU_MAX_STACKS then
            cpu.stacks[stack], cpu.nstacks = count, cpu.nstacks + 1
        else
            cpu.dropped = cpu.dropped + count
        end
    end
    cpu.state[vmstate] = (cpu.state[vmstate] or 0) + count
    cpu.total = cpu.total + count
end

function start_cpu(interval_ms, depth)
    if cpu.active then log("JitProfiler/cpu: already running -- JitProfiler.stop_cpu() first."); return end
    if alloc.capturing then log("JitProfiler/cpu: allocation profiler is running -- JitProfiler.stop_alloc() first."); return end
    cpu.stacks, cpu.state, cpu.total, cpu.nstacks, cpu.dropped = {}, {}, 0, 0, 0
    cpu.iv = math.floor(tonumber(interval_ms) or settings.interval); if cpu.iv < 1 then cpu.iv = 1 end
    cpu.depth = math.floor(tonumber(depth) or settings.depth); if cpu.depth < 1 then cpu.depth = 1 end
    cpu.t0 = get_time_ms()
    cpu.limit = settings.duration
    cpu.active = true
    profile.start("i" .. tostring(cpu.iv), collect_cpu_sample)
    log("JitProfiler/cpu: sampling ON (every %d ms, depth %d). JIT stays on; play, then JitProfiler.stop_cpu().", cpu.iv, cpu.depth)
    show_tip("JitProfiler CPU ON")
end

function stop_cpu()
    if not cpu.active then log("JitProfiler/cpu: not running."); return end
    cpu.active = false
    profile.stop()
    local total = cpu.total
    local v = compute_views(cpu.stacks, cpu.depth)
    local duration_sec = (get_time_ms() - cpu.t0) / 1000.0
    local top_root = sort_entries(v.root)[1]
    local top_leaf = sort_entries(v.leaf)[1]
    local RULE = "================================================================================"
    local stacks_note = cpu.dropped > 0
        and format("%d stacks (capped; +%s beyond the ceiling not attributed)", cpu.nstacks, format_count(cpu.dropped))
        or  format("%d stacks", cpu.nstacks)

    local lines = {
        RULE,
        "  JitProfiler  -  CPU sampling profile   (engine-native; the JIT stays on)",
        format("  modded_exes %s   |   %d samples @ %d ms   |   ~%.0f s   |   %s",
            tostring(_G.MODDED_EXES_VERSION or "?"), total, cpu.iv, duration_sec, stacks_note),
        RULE,
        "",
        "  WHERE THE LUA TIME GOES  (VM state at each sample)",
    }
    for _, state_code in ipairs(VMORDER) do
        local weight = cpu.state[state_code] or 0
        if weight > 0 then
            local percent = compute_pct(weight, total)
            local flag = (state_code == "G" and percent >= 3) and "  <- allocation pressure: run JitProfiler.start_alloc()" or ""
            lines[#lines + 1] = format("    %s  %-20s %s %5.1f%%%s", state_code, VMSTATE[state_code] or state_code, build_bar(percent), percent, flag)
        end
    end
    lines[#lines + 1] = "    (N is a floor: phase-1 sampling under-counts JIT-compiled traces)"
    lines[#lines + 1] = format("  STACK DEPTH   deepest %d, cap %d, %.1f%% of samples reached the cap",
        v.max_depth, cpu.depth, compute_pct(v.clipped, total))
    lines[#lines + 1] = ""
    if top_root then lines[#lines + 1] = format("  TOP DRIVER  %5.1f%%   %s", compute_pct(top_root[2], total), top_root[1]) end
    if top_leaf then lines[#lines + 1] = format("  TOP LEAF    %5.1f%%   %s", compute_pct(top_leaf[2], total), top_leaf[1]) end

    build_view(lines, "BY MOD   Total (on the stack anywhere; does not sum to 100%)", v.by_mod_total, total, format_count)
    build_view(lines, "BY MOD   Own (innermost frame only)", v.by_mod, total, format_count)
    build_view(lines, "BY SCRIPT   Total (on the stack anywhere)", v.by_script_total, total, format_count, { owned = true })
    build_view(lines, "BY SCRIPT   Own (innermost frame only)", v.by_script, total, format_count, { owned = true })
    build_view(lines, "BY LEAF   the hot function (Own)", v.leaf, total, format_count, { owned = true })
    build_view(lines, "BY ROOT   the outermost frame", v.root, total, format_count, { owned = true })
    build_view(lines, "FRAMEWORK vs HANDLERS   dispatch overhead vs real work", v.framework, total, format_count)

    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_cpu_" .. stamp .. ".txt"), lines)
    local folded_path = write_folded("cpu_" .. stamp, cpu.stacks)
    last_capture.cpu = {
        kind = "cpu", by_stack = cpu.stacks, views = v, total = total,
        meta = { samples = total, interval = cpu.iv, duration = duration_sec, stamp = stamp,
                 vmstate = cpu.state, dropped = cpu.dropped, depth = cpu.depth, max_depth = v.max_depth, clipped = v.clipped },
    }
    log("JitProfiler/cpu: report -> %s | flamegraph -> %s (speedscope.app)", tostring(report_path), tostring(folded_path))
    show_tip("JitProfiler CPU report written")
end

-- Allocation profiler: exact per-allocation bytes, drained at instruction boundaries with the JIT off.
alloc = { depth = DEFAULT_STACK_DEPTH, t0 = 0, snap_t0 = 0, snap_n = 0, snap_pct = AUTO_SNAP_PCT, limit = 0,
          capturing = false, jit_was_on = false }

-- Turn a dump result into the text report and folded flamegraph, then write both.
local function write_alloc_report(stacks, duration_sec, suffix, title)
    local total, dropped = 0, tonumber(stacks.dropped) or 0
    local by_stack = {}
    for i = 1, #stacks do by_stack[stacks[i].key] = stacks[i].bytes; total = total + stacks[i].bytes end
    local v = compute_views(by_stack, alloc.depth)
    local drains, pending = tonumber(stacks.drains) or 0, tonumber(stacks.pending) or 0
    if drains == 0 or #stacks == 0 then
        log("!JitProfiler/alloc: capture problem -- drains=%.0f  seen=%s  pending=%s  entries=%d",
            drains, format_bytes(tonumber(stacks.seen) or 0), format_bytes(pending), #stacks)
    end
    local top_root = sort_entries(v.root)[1]
    local top_leaf = sort_entries(v.leaf)[1]
    local RULE = "================================================================================"
    local lines = {
        RULE,
        "  JitProfiler  -  " .. title,
        format("  modded_exes %s   |   %s allocated   |   ~%.0f s   |   %d stacks",
            tostring(_G.MODDED_EXES_VERSION or "?"), format_bytes(total), duration_sec, get_key_count(by_stack)),
        RULE,
        "",
        "  WHO GENERATES THE GARBAGE  (GC churn is the stutter source)",
    }
    if dropped > 0 then
        lines[#lines + 1] = format(
            "  NOTE  window exceeded table capacity; %s not attributed -- snapshot/stop sooner", format_bytes(dropped))
    end
    if top_leaf then lines[#lines + 1] = format("  TOP ALLOCATOR  %5.1f%%   %s", compute_pct(top_leaf[2], total), top_leaf[1]) end
    if top_root then lines[#lines + 1] = format("  TOP DRIVER     %5.1f%%   %s", compute_pct(top_root[2], total), top_root[1]) end
    lines[#lines + 1] = format("  STACK DEPTH    deepest %d, cap %d, %.1f%% of bytes reached the cap",
        v.max_depth, alloc.depth, compute_pct(v.clipped, total))

    build_view(lines, "BY MOD   Total (on the stack anywhere; does not sum to 100%)", v.by_mod_total, total, format_bytes)
    build_view(lines, "BY MOD   Own (innermost frame only)", v.by_mod, total, format_bytes)
    build_view(lines, "BY SCRIPT   Total (on the stack anywhere)", v.by_script_total, total, format_bytes, { owned = true })
    build_view(lines, "BY SCRIPT   Own (innermost frame only)", v.by_script, total, format_bytes, { owned = true })
    build_view(lines, "BY LEAF   who allocates (Own)", v.leaf, total, format_bytes, { owned = true })
    build_view(lines, "BY ROOT   the outermost frame", v.root, total, format_bytes, { owned = true })
    build_view(lines, "FRAMEWORK vs HANDLERS   dispatch overhead vs real work", v.framework, total, format_bytes)

    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_mem" .. suffix .. "_" .. stamp .. ".txt"), lines)
    local folded_path = write_folded("mem" .. suffix .. "_" .. stamp, by_stack)
    if suffix == "" then
        last_capture.mem = {
            kind = "mem", by_stack = by_stack, views = v, total = total,
            meta = { bytes = total, duration = duration_sec, stamp = stamp, stacks = get_key_count(by_stack),
                     dropped = dropped, depth = alloc.depth, max_depth = v.max_depth, clipped = v.clipped },
        }
    end
    log("JitProfiler/alloc: report -> %s | flamegraph -> %s (speedscope.app)", tostring(report_path), tostring(folded_path))
    return total
end

local function is_jit_on()
    return jit and jit.status() and true or false
end

function start_alloc(depth)
    if alloc.capturing then log("JitProfiler/alloc: already running -- JitProfiler.stop_alloc() first."); return end
    if cpu.active then log("JitProfiler/alloc: CPU profiler is running -- JitProfiler.stop_cpu() first."); return end
    alloc.depth = math.floor(tonumber(depth) or settings.depth); if alloc.depth < 2 then alloc.depth = 2 end
    alloc.t0 = get_time_ms()
    alloc.limit = settings.duration
    alloc.snap_t0 = alloc.t0
    alloc.snap_n = 0
    alloc.jit_was_on = is_jit_on()
    if jit then jit.flush(); jit.off() end
    alloc.snap_pct = settings.auto_snap
    allocprof.start(alloc.depth)
    alloc.capturing = true
    log("JitProfiler/alloc: ON (JIT off, exact bytes, depth %d). Play, then JitProfiler.stop_alloc(). Auto-dumps at %d%% full.", alloc.depth, alloc.snap_pct)
    show_tip("JitProfiler ALLOC ON")
end

-- Read the allocation table, optionally resetting it in the same call.
local function read_alloc(reset)
    return allocprof.dump(true, reset)
end

-- Dump the current window to a numbered report and keep capturing so a long session never fills the tables.
function write_snapshot(auto)
    if not alloc.capturing then log("JitProfiler/alloc: not running."); return end
    allocprof.pause()
    alloc.snap_n = alloc.snap_n + 1
    local stacks = read_alloc(true)
    local duration_sec = (get_time_ms() - alloc.snap_t0) / 1000.0
    write_alloc_report(stacks, duration_sec, "_snap" .. tostring(alloc.snap_n),
        "allocation snapshot " .. tostring(alloc.snap_n)
        .. (auto and " (auto, table full)" or "") .. "   (exact bytes)")
    alloc.snap_t0 = get_time_ms()
    allocprof.resume()
    show_tip("JitProfiler ALLOC snapshot " .. tostring(alloc.snap_n))
end

function stop_alloc()
    if not alloc.capturing then log("JitProfiler/alloc: not running."); return end
    alloc.capturing = false
    allocprof.stop()
    if jit and alloc.jit_was_on then jit.on() end
    local stacks = read_alloc(false)
    local duration_sec = (get_time_ms() - alloc.t0) / 1000.0
    write_alloc_report(stacks, duration_sec, "", "allocation profile   (exact bytes)")
    show_tip("JitProfiler ALLOC report written")
end

-- Per-frame heartbeat: auto-stop a capture at its duration limit, auto-snapshot before the alloc table fills. Near-free when idle.
local function update_capture()
    if cpu.active then
        if cpu.limit > 0 and (get_time_ms() - cpu.t0) / 1000 >= cpu.limit then stop_cpu() end
        return
    end
    if not alloc.capturing then return end
    if alloc.limit > 0 and (get_time_ms() - alloc.t0) / 1000 >= alloc.limit then stop_alloc(); return end
    if allocprof.usage() >= alloc.snap_pct then write_snapshot(true) end
end
-- Fold the anomaly baseline rows out of the owned views, read at the next report.
function set_fold_anomaly(on)
    fold_override = on and true or false
    log("JitProfiler: fold anomaly = %s (applies to the next report)", tostring(fold_override))
end

--- @return table|nil the retained aggregate for kind "cpu" or "mem", or nil when nothing was captured yet.
function get_last_capture(kind)
    return last_capture[kind]
end

--- @return number|boolean the current session value for a capture setting.
function get_setting(key)
    return settings[key]
end

--- Store a session capture setting edited from the panel; never persisted.
function set_setting(key, value)
    settings[key] = value
end

--- @return string the owner (mod / modded exes / anomaly / engine / unknown) for a view key, resolved through the script it names.
function get_owner(key)
    if key:find("%[C%]") then return OWNER_ENGINE end
    local script_file = key:match("([%w_%.%-]+%.script)") or key:match("([%w_%.%-]+%.lua)")
    return script_file and get_script_owner(script_file) or OWNER_UNKNOWN
end

--- @return string the owner with an "(override: <file>)" note when a mod serves a vanilla-named script, for row display only.
function get_owner_label(key)
    local owner = get_owner(key)
    if owner:sub(1, #OWNER_MOD) ~= OWNER_MOD then return owner end
    local script_file = key:match("([%w_%.%-]+%.script)") or key:match("([%w_%.%-]+%.lua)")
    if script_file and jitprofiler_names.is_vanilla(script_file) then
        return owner .. " (override: " .. script_file .. ")"
    end
    return owner
end

function is_cpu_active()
    return cpu.active
end

function is_mem_active()
    return alloc.capturing
end

--- @return table|nil { elapsed, limit } in seconds for the running capture, or nil when idle.
function get_capture_progress()
    if cpu.active then return { elapsed = (get_time_ms() - cpu.t0) / 1000, limit = cpu.limit } end
    if alloc.capturing then return { elapsed = (get_time_ms() - alloc.t0) / 1000, limit = alloc.limit } end
    return nil
end

-- One stack's contribution to a frame's neighbors: callers stand toward root (i+1), callees toward leaf (i-1).
local function collect_neighbors(entry, frame, out)
    local frames, count = {}, 0
    for raw in string.gmatch(entry.stack, "[^;]+") do count = count + 1; frames[count] = get_short_frame(raw) end
    for i = 1, count do
        local matched = frames[i] == frame
        local up = matched and frames[i + 1]
        local down = matched and frames[i - 1]
        if up then out.callers[up] = (out.callers[up] or 0) + entry.weight end
        if down then out.callees[down] = (out.callees[down] or 0) + entry.weight end
    end
end

-- Callers (toward root) and callees (toward leaf) of a frame, summed across the retained leaf-first stacks.
function compute_neighbors(kind, frame)
    local cap = last_capture[kind]
    if not (cap and frame) then return nil end
    local out = { callers = {}, callees = {} }
    for stack, weight in pairs(cap.by_stack) do
        collect_neighbors({ stack = stack, weight = weight }, frame, out)
    end
    return { callers = sort_entries(out.callers), callees = sort_entries(out.callees) }
end

-- The chunk executes twice (see the _G capture anchor above), so guard the one-time callback registration.
function on_game_start()
    if rawget(_G, "__jitprofiler_started") then return end
    rawset(_G, "__jitprofiler_started", true)
    RegisterScriptCallback("actor_on_update", update_capture)
    log("JitProfiler ready.  CPU: start_cpu([ms],[depth]) / stop_cpu().  ALLOC: start_alloc([depth]) / write_snapshot() / stop_alloc().")
    log("JitProfiler: set_fold_anomaly(true) folds the vanilla baseline.  Reports go to appdata/logs/jitprofiler_*.")
end
