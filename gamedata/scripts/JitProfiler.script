--- JitProfiler: engine-native LuaJIT sampling profiler over jit.profile/jit.allocprof; usage in doc/readme.txt.

local CPU_INTERVAL_MS     = 5
local DEFAULT_STACK_DEPTH = 64
local CPU_MAX_STACKS      = 50000
local SCAN_MAX_DEPTH      = 200
local AUTO_SNAP_PCT       = 90
local BYTES_PER_MB        = 1048576
local OWNER_ANOMALY       = "anomaly"
local OWNER_UNKNOWN       = "unknown"
local OWNER_ENGINE        = "engine"
local OWNER_MODDED        = "modded exes"
local OWNER_MOD           = "mod: "
local OWNER_LOOSE         = "loose: "
local OWNER_STRING        = "loadstring"

local string, table, math, pairs = string, table, math, pairs
local pcall, tostring, tonumber, require, type = pcall, tostring, tonumber, require, type
local format = string.format
local time_global, jit = time_global, jit
local RegisterScriptCallback = RegisterScriptCallback
local rawget, rawset = rawget, rawset
local error, unpack, select, next = error, unpack, select, next

-- Ticks in these states ran no Lua; a pseudo-leaf books their weight to the engine, never to the re-entry script.
local VMSTATE_LEAF = { C = "[C]:-1", G = "[GC]:-1", J = "[JIT]:-1" }
local PSEUDO_FRAME = { ["[C]:-1"] = true, ["[GC]:-1"] = true, ["[JIT]:-1"] = true }

-- Callback-dispatch machinery, matched by leaf name to split framework cost from real handler work.
local DISPATCH = {
    make_callback = true, SendScriptCallback = true, callback = true,
    callback_set = true, callback_unset = true, spairs = true,
}

-- xlog resolves at call time: JitProfiler evaluates before xlibs, so the logger is built on first use.
local log_handle
local function log(fmt, ...)
    if not log_handle then
        log_handle = xlog.get_logger("JitProfiler", { outfile = "jitprofiler.log", level = "INFO" })
    end
    log_handle.info(fmt, ...)
end

--- @safety SAFE - require() of an optional module runs under pcall; a missing module yields nil for the guard below.
local function find_module(name)
    local ok, module = pcall(require, name)
    return ok and module or nil
end

-- On a stock exe the primitives are absent, so report it and stub the commands as no-ops.
local profile   = find_module("jit.profile")
local allocprof = find_module("jit.allocprof")
-- GC counters getter (profiler build only); nil elsewhere, so the GC report block is skipped.
local gcstat_fn = jit and jit.util and jit.util.gcstat
if not (profile and allocprof) then
    local function log_absent() log("!JitProfiler: this exe lacks jit.profile/jit.allocprof; it needs a demonized profiler build.") end
    start_cpu, stop_cpu, start_alloc, stop_alloc, write_snapshot, set_fold_baseline = log_absent, log_absent, log_absent, log_absent, log_absent, log_absent
    is_cpu_active = function() return false end
    is_mem_active = function() return false end
    get_capture_progress = function() return nil end
    get_last_capture = function() return nil end
    get_owner = function() return OWNER_UNKNOWN end
    get_owner_label = function() return OWNER_UNKNOWN end
    get_owner_method = function() return "?" end
    is_resolve_ready = function() return false end
    get_alloc_usage = function() return nil end
    get_setting = function() return 0 end
    set_setting = function() end
    is_scan_active = function() return false end
    is_target = function() return false end
    get_targets = function() return {} end
    get_target_stats = function() return 0, 0 end
    add_target, remove_target, start_scan, stop_scan = log_absent, log_absent, log_absent, log_absent
    start_callbacks, stop_callbacks = log_absent, log_absent
    is_callbacks_active = function() return false end
    add_callback_target, remove_callback_target = log_absent, log_absent
    is_callback_target = function() return false end
    get_callback_pick_count = function() return 0 end
    get_registered_callbacks = function() return {} end
    return
end

local function show_tip(msg)
    if db and db.actor then news_manager.send_tip(db.actor, msg, nil, nil, 4000) end
end

local function get_time_ms()
    return (time_global and time_global()) or 0
end

-- The scripts-relative path (forward slash) of the .script/.lua a frame or key names; nil for a pseudo-leaf or no file token.
-- A subdir module keeps its subpath; a LuaJIT '...' short_src truncation is stripped so a long path keys to its real basename, not '...cripts/name'.
local function get_script_id(str)
    local path = str:match("([%w_%.%-\\/]+%.script)") or str:match("([%w_%.%-\\/]+%.lua)")
    if not path then return nil end
    return (path:gsub("\\", "/"):gsub("^.*/scripts/", ""):gsub("^%.%.%.[^/]*/", ""))
end

-- Reduce a frame to its scripts-relative script file for the by-script rollup; a .lua rolls to its file just like a .script.
local function get_frame_script(frame)
    return get_script_id(frame) or get_short_frame(frame)
end

-- Leaf function name for the framework-vs-handler match.
local function get_leaf_name(frame)
    return frame:match("^([%w_]+)@") or ""
end

-- Per-mod origin resolver: the owning mod from the file's real backing path via MO2/USVFS.
local origin_cache = {}
local origin_method = {}
local resolve_ready = false
local fold_override
local ffi, k32

-- Session capture settings, anchored to _G so the two chunk generations share one table. Edited from the panel, never persisted.
local settings = rawget(_G, "__jitprofiler_settings")
if not settings then
    settings = { interval = CPU_INTERVAL_MS, depth = DEFAULT_STACK_DEPTH,
                 auto_snap = AUTO_SNAP_PCT, duration = 0, fold = false }
    rawset(_G, "__jitprofiler_settings", settings)
end

--- @safety SAFE - each optional FFI step runs under pcall; any failure leaves resolve_ready false and owners unknown.
local function init_ffi()
    local ok_ffi, module = pcall(require, "ffi")
    if not (ok_ffi and module) then return end
    local ok_decl = pcall(module.cdef, [[
        void* __stdcall CreateFileA(const char*, unsigned long, unsigned long, void*, unsigned long, unsigned long, void*);
        unsigned long __stdcall GetFinalPathNameByHandleA(void*, char*, unsigned long, unsigned long);
        int __stdcall CloseHandle(void*);
    ]])
    if not ok_decl then return end
    local ok_load, lib = pcall(module.load, "kernel32")
    if not ok_load then return end
    ffi, k32, resolve_ready = module, lib, true
end
init_ffi()

-- Real backing path of a virtual script path via the OS handle; nil when the open fails (packed base db0) or the path exceeds the 1024-byte buffer.
local function resolve_real_path(vpath)
    local invalid = ffi.cast("void*", -1)
    local handle = k32.CreateFileA(vpath, 0x80000000, 0x1, nil, 3, 0, nil)
    if handle == invalid or handle == nil then return nil end
    local buffer = ffi.new("char[?]", 1024)
    local written = k32.GetFinalPathNameByHandleA(handle, buffer, 1024, 0)
    k32.CloseHandle(handle)
    return (written > 0 and written < 1024) and ffi.string(buffer) or nil
end

-- Owner from the winning mod (real backing path), then the baked name sets, then the loose folder for a stray file, else unknown.
-- origin_method records how the owner was decided: mod (real mods\ path), loose (real non-mod path), packed (open failed, so in a db), name (no FFI guess).
--- @safety SAFE - pcall contains any FFI error to a nil path, so an unresolved script falls through to the name sets.
local function get_script_owner(script_file)
    if not script_file or script_file == "" then return OWNER_UNKNOWN end
    if origin_cache[script_file] then return origin_cache[script_file] end
    local owner, method, loose_root
    if resolve_ready then
        local ok, real = pcall(resolve_real_path, xfs.resolve_path("$game_scripts$", script_file))
        if ok and real then
            local mod = real:match("[\\/][Mm][Oo][Dd][Ss][\\/]([^\\/]+)")
            if mod then owner, method = OWNER_MOD .. mod, "mod" else method, loose_root = "loose", real:match("[\\/]([^\\/]+)[\\/][Gg]amedata[\\/]") end
        else
            method = "packed"
        end
    else
        method = "name"
    end
    if not owner then
        if jitprofiler_names.is_modded_exes(script_file) then owner = OWNER_MODDED
        elseif jitprofiler_names.is_vanilla(script_file) then owner = OWNER_ANOMALY
        elseif loose_root then owner = OWNER_LOOSE .. loose_root
        else owner = OWNER_UNKNOWN end
    end
    origin_cache[script_file] = owner
    origin_method[script_file] = method
    return owner
end

-- Effective fold for a report: the console override if set, else the panel setting. Passed to jitprofiler_report.
local function get_fold()
    local fold = fold_override
    if fold == nil then fold = settings.fold and true or false end
    return fold
end

-- Split the leaf frame into callback-dispatch overhead versus real handler work.
local function get_stack_bucket(leaf_frame)
    return DISPATCH[get_leaf_name(leaf_frame)] and "[framework] callback dispatch" or "[handlers] mod + engine work"
end

-- A runtime-compiled chunk (loadstring/loadfile) frame: no backing file, so it can own no mod.
local function is_string_frame(frame)
    return frame:find("%[string") ~= nil
end

-- The frame Own weight books to: past a prepended [C]/[GC]/[JIT] pseudo-leaf or a [string] chunk, to the real Lua frame below that drove it.
local function get_anchor_frame(first, second, nframes)
    if PSEUDO_FRAME[first] and second and nframes >= 3 then return second end
    if is_string_frame(first) and second and not PSEUDO_FRAME[second] and not is_string_frame(second) and get_script_id(second) then return second end
    return first
end

-- Frame count excluding a prepended pseudo-leaf, so the depth and at-cap metrics do not count the [C]/[GC]/[JIT] marker.
local function get_real_frame_count(first, nframes)
    return PSEUDO_FRAME[first] and (nframes - 1) or nframes
end

-- Book a pseudo-led stack to its engine-C entry point (the resuming Lua frame), or to the trunk when no Lua frame resumed.
local function collect_engine_entry(v, first, anchor, leaf_key, weight)
    if not PSEUDO_FRAME[first] then return end
    if anchor == first then v.engine_trunk = v.engine_trunk + weight
    else v.engine_entry[leaf_key] = (v.engine_entry[leaf_key] or 0) + weight end
end

-- Credit one captured stack into every ranked map and update the depth stats.
local function collect_stack(v, stack, weight, cap)
    local first, second, last, nframes = nil, nil, nil, 0
    local seen_owner, seen_script = {}, {}
    for frame in string.gmatch(stack, "[^;]+") do
        if not first then first = frame
        elseif not second then second = frame end
        last = frame
        nframes = nframes + 1
        seen_owner[get_owner(frame)] = true
        seen_script[get_frame_script(frame)] = true
    end
    first, last = first or "?", last or "?"
    local anchor = get_anchor_frame(first, second, nframes)
    local leaf_key = get_short_frame(anchor)
    local script_file = get_frame_script(anchor)
    local owner = get_owner(anchor)
    collect_engine_entry(v, first, anchor, leaf_key, weight)
    v.leaf[leaf_key]              = (v.leaf[leaf_key] or 0) + weight
    v.by_script[script_file]      = (v.by_script[script_file] or 0) + weight
    v.root[get_short_frame(last)] = (v.root[get_short_frame(last)] or 0) + weight
    v.by_mod[owner]               = (v.by_mod[owner] or 0) + weight
    for owner_key in pairs(seen_owner) do v.by_mod_total[owner_key] = (v.by_mod_total[owner_key] or 0) + weight end
    for script_key in pairs(seen_script) do v.by_script_total[script_key] = (v.by_script_total[script_key] or 0) + weight end
    local real_frames = get_real_frame_count(first, nframes)
    if real_frames > v.max_depth then v.max_depth = real_frames end
    if cap and real_frames >= cap then v.clipped = v.clipped + weight end
    local bucket = get_stack_bucket(anchor)
    v.framework[bucket]           = (v.framework[bucket] or 0) + weight
end

-- Own (innermost, exclusive) and Total (any frame, inclusive) maps per mod and per script, plus root, framework, and depth stats.
local function compute_views(by_stack, cap)
    local v = { leaf = {}, by_script = {}, root = {}, framework = {},
                by_mod = {}, by_mod_total = {}, by_script_total = {},
                engine_entry = {}, engine_trunk = 0, max_depth = 0, clipped = 0 }
    for stack, weight in pairs(by_stack) do collect_stack(v, stack, weight, cap) end
    return v
end

-- Forward-declared so the CPU, allocation, scan, and callbacks engines can see each other and stay mutually exclusive.
local alloc, scan, callbacks

-- Anchored to _G: the chunk executes twice, so the actor_on_update heartbeat and the console entry points must share one table.
local cpu = rawget(_G, "__jitprofiler_cpu") or { stacks = {}, state = {}, total = 0, nstacks = 0, dropped = 0, iv = CPU_INTERVAL_MS, depth = DEFAULT_STACK_DEPTH, t0 = 0, limit = 0, active = false }
rawset(_G, "__jitprofiler_cpu", cpu)

-- The most recent CPU, allocation, and scan capture, retained for the in-game panel to render.
local last_capture = rawget(_G, "__jitprofiler_capture")
if not last_capture then
    last_capture = { cpu = nil, mem = nil, scan = nil }
    rawset(_G, "__jitprofiler_capture", last_capture)
end

local function collect_cpu_sample(thread, count, vmstate)
    local stack = profile.dumpstack(thread, "", cpu.depth)
    if stack and stack ~= "" then
        local pseudo = VMSTATE_LEAF[vmstate]
        if pseudo then stack = pseudo .. ";" .. stack end
        local current = cpu.stacks[stack]
        if current then
            cpu.stacks[stack] = current + count
        elseif cpu.nstacks < CPU_MAX_STACKS then
            cpu.stacks[stack], cpu.nstacks = count, cpu.nstacks + 1
        else
            cpu.dropped = cpu.dropped + count
        end
    end
    cpu.state[vmstate] = (cpu.state[vmstate] or 0) + count
    cpu.total = cpu.total + count
end

-- GC-pressure line for a report header: live gcstat plus collections and rate over the capture. nil on a stock exe.
local function build_gc_line(gc0, duration_sec)
    if not gcstat_fn then return nil end
    local stat = gcstat_fn()
    local cycles = (stat.cycles or 0) - (gc0 or 0)
    local rate = duration_sec > 0 and cycles / duration_sec or 0
    return format("  GC   heap %.1f / %.1f MB to next   |   estimate %.1f MB   debt %.0f B   |   %d collections (~%.1f/s)",
        stat.total / BYTES_PER_MB, stat.threshold / BYTES_PER_MB, stat.estimate / BYTES_PER_MB, stat.debt, cycles, rate)
end

function start_cpu(interval_ms, depth)
    if cpu.active then log("JitProfiler/cpu: already running -- JitProfiler.stop_cpu() first."); return end
    if alloc.capturing then log("JitProfiler/cpu: allocation profiler is running -- JitProfiler.stop_alloc() first."); return end
    if scan.active then log("JitProfiler/cpu: scanner is running -- JitProfiler.stop_scan() first."); return end
    if callbacks.active then log("JitProfiler/cpu: callbacks profiler is running -- JitProfiler.stop_callbacks() first."); return end
    cpu.stacks, cpu.state, cpu.total, cpu.nstacks, cpu.dropped = {}, {}, 0, 0, 0
    cpu.iv = math.floor(tonumber(interval_ms) or settings.interval); if cpu.iv < 1 then cpu.iv = 1 end
    cpu.depth = math.floor(tonumber(depth) or settings.depth); if cpu.depth < 1 then cpu.depth = 1 end
    cpu.t0 = get_time_ms()
    cpu.gc0 = gcstat_fn and gcstat_fn().cycles or 0
    cpu.limit = settings.duration
    cpu.active = true
    profile.start("i" .. tostring(cpu.iv), collect_cpu_sample)
    log("JitProfiler/cpu: sampling ON (every %d ms, depth %d). JIT stays on; play, then JitProfiler.stop_cpu().", cpu.iv, cpu.depth)
    show_tip("JitProfiler CPU ON")
end

function stop_cpu()
    if not cpu.active then log("JitProfiler/cpu: not running."); return end
    cpu.active = false
    profile.stop()
    local v = compute_views(cpu.stacks, cpu.depth)
    local duration_sec = (get_time_ms() - cpu.t0) / 1000.0
    local gc_line = build_gc_line(cpu.gc0, duration_sec)
    last_capture.cpu = jitprofiler_report.write_cpu(cpu, v,
        { total = cpu.total, duration = duration_sec, gc_line = gc_line, fold = get_fold() })
    show_tip("JitProfiler CPU report written")
end

-- Allocation profiler: exact per-allocation bytes, drained at instruction boundaries with the JIT off. Anchored to _G like cpu/scan.
alloc = rawget(_G, "__jitprofiler_alloc") or { depth = DEFAULT_STACK_DEPTH, t0 = 0, snap_t0 = 0, snap_n = 0,
        snap_pct = AUTO_SNAP_PCT, limit = 0, capturing = false, jit_was_on = false }
rawset(_G, "__jitprofiler_alloc", alloc)

-- Fold the raw dump into by_stack + computed views, then hand jitprofiler_report the text/flamegraph work.
local function write_alloc_report(stacks, duration_sec, suffix, title)
    local total = 0
    local by_stack = {}
    for i = 1, #stacks do by_stack[stacks[i].key] = stacks[i].bytes; total = total + stacks[i].bytes end
    local v = compute_views(by_stack, alloc.depth)
    local diag = { drains = tonumber(stacks.drains) or 0, pending = tonumber(stacks.pending) or 0,
                   seen = tonumber(stacks.seen) or 0, dropped = tonumber(stacks.dropped) or 0, entries = #stacks }
    local gc_line = build_gc_line(alloc.gc0, duration_sec)
    local capture = jitprofiler_report.write_alloc(v, { by_stack = by_stack, total = total, duration = duration_sec,
        suffix = suffix, title = title, depth = alloc.depth, peak = alloc.peak or 0, gc_line = gc_line, fold = get_fold(), diag = diag })
    if suffix == "" then last_capture.mem = capture end
    return total
end

local function is_jit_on()
    return jit and jit.status() and true or false
end

function start_alloc(depth)
    if alloc.capturing then log("JitProfiler/alloc: already running -- JitProfiler.stop_alloc() first."); return end
    if cpu.active then log("JitProfiler/alloc: CPU profiler is running -- JitProfiler.stop_cpu() first."); return end
    if scan.active then log("JitProfiler/alloc: scanner is running -- JitProfiler.stop_scan() first."); return end
    if callbacks.active then log("JitProfiler/alloc: callbacks profiler is running -- JitProfiler.stop_callbacks() first."); return end
    alloc.depth = math.floor(tonumber(depth) or settings.depth); if alloc.depth < 2 then alloc.depth = 2 end
    alloc.t0 = get_time_ms()
    alloc.gc0 = gcstat_fn and gcstat_fn().cycles or 0
    alloc.peak = 0
    alloc.limit = settings.duration
    alloc.snap_t0 = alloc.t0
    alloc.snap_n = 0
    alloc.jit_was_on = is_jit_on()
    if jit then jit.flush(); jit.off() end
    alloc.snap_pct = settings.auto_snap
    allocprof.start(alloc.depth)
    alloc.capturing = true
    log("JitProfiler/alloc: ON (JIT off, exact bytes, depth %d). FPS drops hard on a heavy modpack; capture short, then JitProfiler.stop_alloc(). Auto-dumps at %d%% full.",
        alloc.depth, alloc.snap_pct)
    show_tip("JitProfiler ALLOC ON")
end

-- Read the allocation table, optionally resetting it in the same call.
local function read_alloc(reset)
    return allocprof.dump(true, reset)
end

-- Dump the current window to a numbered report and keep capturing so a long session never fills the tables.
function write_snapshot(auto)
    if not alloc.capturing then log("JitProfiler/alloc: not running."); return end
    allocprof.pause()
    alloc.snap_n = alloc.snap_n + 1
    local stacks = read_alloc(true)
    local duration_sec = (get_time_ms() - alloc.snap_t0) / 1000.0
    write_alloc_report(stacks, duration_sec, "_snap" .. tostring(alloc.snap_n),
        "allocation snapshot " .. tostring(alloc.snap_n)
        .. (auto and " (auto, table full)" or "") .. "   (exact bytes)")
    alloc.snap_t0 = get_time_ms()
    allocprof.resume()
    show_tip("JitProfiler ALLOC snapshot " .. tostring(alloc.snap_n))
end

function stop_alloc()
    if not alloc.capturing then log("JitProfiler/alloc: not running."); return end
    alloc.capturing = false
    allocprof.stop()
    if jit and alloc.jit_was_on then jit.on() end
    local stacks = read_alloc(false)
    local duration_sec = (get_time_ms() - alloc.snap_t0) / 1000.0
    write_alloc_report(stacks, duration_sec, "", "allocation profile   (exact bytes)")
    show_tip("JitProfiler ALLOC report written")
end

-- Instrumentation: wrap every function of a target-script SET and time each call for self and total, counting calls.
scan = rawget(_G, "__jitprofiler_scan") or { set = {}, count = 0, records = {}, saved = {}, wrapped = 0, edges = {},
       stack = {}, sp = 0, t0 = 0, limit = 0, frames = 0, active = false }
rawset(_G, "__jitprofiler_scan", scan)

-- Callbacks: time every registered handler by wrapping the make_callback intercepts table in place; state anchored to _G.
callbacks = rawget(_G, "__jitprofiler_callbacks")
if not callbacks then
    callbacks = { active = false, records = {}, saved = {}, stack = {}, sp = 0, wrapped = 0, t0 = 0, limit = 0, set = {} }
    rawset(_G, "__jitprofiler_callbacks", callbacks)
end
callbacks.set = callbacks.set or {}
local INTERCEPTS_UPVALUE = "intercepts"
local intercepts_ref

-- Never wrap the profiler's own machinery: the wrapper builds each frame's timer with xprofiler, so wrapping xprofiler recurses without end.
local SCAN_BLACKLIST = {
    xprofiler = true, JitProfiler = true, jitprofiler_ui = true,
    jitprofiler_names = true, jf_mcm = true, _jitprofiler_deps = true,
}

-- Collect a call's results with an explicit count, so a nil inside the return list survives unpack.
local function collect_results(...)
    return select("#", ...), { ... }
end

-- One wrapper: time the call on a pooled stack frame, bank self and total, charge the span to the parent.
--- @safety SAFE - pcall keeps a wrapped error from skipping the frame close; the error re-raises unchanged (level 0).
local function build_wrapper(rec, original)
    return function(...)
        local sp = scan.sp + 1
        if sp > SCAN_MAX_DEPTH then return original(...) end
        scan.sp = sp
        local frame = scan.stack[sp]
        if not frame then frame = { timer = xprofiler.new() }; scan.stack[sp] = frame end
        frame.rec, frame.child_us = rec, 0
        frame.timer:reset(); frame.timer:start()
        local count, ret = collect_results(pcall(original, ...))
        frame.timer:stop()
        local elapsed = frame.timer:get_us()
        local own = elapsed - frame.child_us
        rec.total_us = rec.total_us + elapsed
        rec.self_us  = rec.self_us + own
        rec.calls    = rec.calls + 1
        if own > rec.max_us then rec.max_us = own end
        if own < rec.min_us then rec.min_us = own end
        scan.sp = sp - 1
        if sp > 1 then
            local parent = scan.stack[sp - 1]
            parent.child_us = parent.child_us + elapsed
            local bucket = scan.edges[parent.rec.key]
            if not bucket then bucket = {}; scan.edges[parent.rec.key] = bucket end
            local edge = bucket[rec.key]
            if not edge then edge = { calls = 0, us = 0 }; bucket[rec.key] = edge end
            edge.calls = edge.calls + 1
            edge.us = edge.us + elapsed
        end
        if ret[1] then return unpack(ret, 2, count) end
        error(ret[2], 0)
    end
end

-- Build wrappers over every function of one loaded script, saving originals for restore. Returns the count, 0 if absent or empty.
local function build_wraps(name)
    local mod = rawget(_G, name)
    if type(mod) ~= "table" then return 0 end
    local saved, count = {}, 0
    for func_name, value in pairs(mod) do
        if type(value) == "function" then
            saved[func_name] = value
            local info = debug.getinfo(value, "S")
            local src = (info and info.short_src) or "?"
            local key = get_short_frame(func_name .. "@" .. src .. ":" .. tostring((info and info.linedefined) or -1))
            local rec = scan.records[key] or { key = key, calls = 0, self_us = 0, total_us = 0, min_us = math.huge, max_us = 0 }
            scan.records[key] = rec
            mod[func_name] = build_wrapper(rec, value)
            count = count + 1
        end
    end
    if count > 0 then scan.saved[name] = saved; scan.wrapped = scan.wrapped + count end
    return count
end

-- Restore one script's original functions.
local function remove_wraps(name)
    local saved = scan.saved[name]
    if not saved then return end
    local mod = rawget(_G, name)
    if type(mod) == "table" then
        for func_name, original in pairs(saved) do mod[func_name] = original end
    end
    scan.saved[name] = nil
end

--- Add a script to the instrumentation set; wraps it live when a capture is running.
--- @novalidate(code.unused_export, reason:"panel control surface")
function add_target(name)
    name = tostring(name or ""):gsub("%.script$", "")
    if name == "" or scan.set[name] or SCAN_BLACKLIST[name] then return end
    scan.set[name] = true
    scan.count = scan.count + 1
    if scan.active then build_wraps(name) end
end

--- Remove a script from the instrumentation set; unwraps it live when a capture is running.
--- @novalidate(code.unused_export, reason:"panel control surface")
function remove_target(name)
    name = tostring(name or ""):gsub("%.script$", "")
    if not scan.set[name] then return end
    scan.set[name] = nil
    scan.count = scan.count - 1
    if scan.active then remove_wraps(name) end
end

--- Add every loaded script a mod owns to the instrumentation set.
--- @novalidate(code.unused_export, reason:"panel control surface")
function add_mod_targets(owner)
    for name in pairs(_G) do
        local mod = type(name) == "string" and rawget(_G, name)
        if type(mod) == "table" and get_owner(name .. ".script") == owner then add_target(name) end
    end
end

--- @return boolean whether a script is in the instrumentation set.
--- @novalidate(code.unused_export, reason:"panel control surface")
function is_target(name)
    return scan.set[tostring(name or ""):gsub("%.script$", "")] == true
end

--- @return number, number the count of targeted scripts and of wrapped functions.
--- @novalidate(code.unused_export, reason:"panel control surface")
function get_target_stats()
    return scan.count, scan.wrapped
end

--- @return table the sorted list of script names in the instrumentation set.
--- @novalidate(code.unused_export, reason:"panel control surface")
function get_targets()
    local list = {}
    for name in pairs(scan.set) do list[#list + 1] = name end
    table.sort(list)
    return list
end

--- Arm instrumentation: wrap every function of every script in the set. Play, then stop_scan().
--- @novalidate(code.unused_export, reason:"console command")
function start_scan(script_name)
    if scan.active then log("JitProfiler/inst: already running -- JitProfiler.stop_scan() first."); return end
    if cpu.active then log("JitProfiler/inst: CPU profiler is running -- JitProfiler.stop_cpu() first."); return end
    if alloc.capturing then log("JitProfiler/inst: allocation profiler is running -- JitProfiler.stop_alloc() first."); return end
    if callbacks.active then log("JitProfiler/inst: callbacks profiler is running -- JitProfiler.stop_callbacks() first."); return end
    if script_name and tostring(script_name) ~= "" then add_target(script_name) end
    if scan.count == 0 then log("JitProfiler/inst: the set is empty -- add a script first."); return end
    scan.records, scan.saved, scan.wrapped, scan.frames, scan.sp, scan.edges = {}, {}, 0, 0, 0, {}
    scan.t0, scan.limit, scan.active = get_time_ms(), settings.duration, true
    for name in pairs(scan.set) do build_wraps(name) end
    log("JitProfiler/inst: wrapping %d scripts (%d functions). Play, then JitProfiler.stop_scan().", scan.count, scan.wrapped)
    show_tip(format("JitProfiler INSTRUMENT %d scripts", scan.count))
end

--- Restore every wrapped function and write the report.
--- @novalidate(code.unused_export, reason:"console command")
function stop_scan()
    if not scan.active then log("JitProfiler/inst: not running."); return end
    scan.active = false
    for name in pairs(scan.saved) do remove_wraps(name) end
    scan.sp = 0
    local duration_sec = (get_time_ms() - scan.t0) / 1000.0
    last_capture.scan = jitprofiler_report.write_scan(scan.records,
        { frames = scan.frames, duration = duration_sec, targets = scan.count, wrapped = scan.wrapped, edges = scan.edges })
    show_tip("JitProfiler INSTRUMENTATION report written")
end

--- @novalidate(code.unused_export, reason:"panel control surface, wired in the UI increment")
function is_scan_active()
    return scan.active
end

-- The intercepts table is file-local in axr_main; make_callback closes over it, so read the reference by upvalue.
-- make_callback lives in the axr_main module table like every axr_main function, never as a bare _G global.
--- @safety SAFE - if the upvalue is absent (a build without it) intercepts_ref stays nil and the callbacks mode goes inert.
local function resolve_intercepts()
    if intercepts_ref then return true end
    if not (debug and debug.getupvalue) then return false end
    local axr = rawget(_G, "axr_main")
    local mc = type(axr) == "table" and axr.make_callback or nil
    if type(mc) ~= "function" then return false end
    for i = 1, 60 do
        local name, value = debug.getupvalue(mc, i)
        if not name then break end
        if name == INTERCEPTS_UPVALUE and type(value) == "table" then intercepts_ref = value; return true end
    end
    return false
end

-- name@<scripts-relative path>:line for a handler, for the record key and owner resolve.
local function get_handler_frame(handler)
    local info = debug.getinfo(handler, "nS")
    local src = (info and info.short_src) or "?"
    return get_short_frame((info and info.name or "?") .. "@" .. src .. ":" .. (info and info.linedefined or -1))
end

-- A handler defined in one of our own scripts must never be wrapped (it would time or recurse the profiler).
--- @safety SAFE - debug.getinfo on a function is read-only; a nil short_src just means the handler is not ours.
local function is_own_handler(handler)
    local info = debug.getinfo(handler, "S")
    local src = info and info.short_src
    return src ~= nil and src:lower():find("jitprofiler", 1, true) ~= nil
end

-- The function handlers of one callback that are safe to wrap, each with its priority.
local function collect_handlers(handlers)
    local to_wrap = {}
    for handler, prio in pairs(handlers) do
        if type(handler) == "function" and not is_own_handler(handler) then to_wrap[#to_wrap + 1] = { handler, prio } end
    end
    return to_wrap
end

-- One callbacks wrapper: time the handler inclusive of engine C, bank own/total, re-raise a handler error unchanged.
--- @safety SAFE - pcall keeps the frame close on a handler error; error re-raises at level 0, matching make_callback's raw dispatch.
local function build_callbacks_wrapper(rec, handler)
    return function(...)
        local sp = callbacks.sp + 1
        if sp > SCAN_MAX_DEPTH then return handler(...) end
        callbacks.sp = sp
        local frame = callbacks.stack[sp]
        if not frame then frame = { timer = xprofiler.new() }; callbacks.stack[sp] = frame end
        frame.child_us = 0
        frame.timer:reset(); frame.timer:start()
        local count, ret = collect_results(pcall(handler, ...))
        frame.timer:stop()
        local elapsed = frame.timer:get_us()
        local own = elapsed - frame.child_us
        rec.total_us = rec.total_us + elapsed
        rec.self_us  = rec.self_us + own
        rec.calls    = rec.calls + 1
        if own > rec.max_us then rec.max_us = own end
        if own < rec.min_us then rec.min_us = own end
        callbacks.sp = sp - 1
        if sp > 1 then
            local parent = callbacks.stack[sp - 1]
            parent.child_us = parent.child_us + elapsed
        end
        if ret[1] then return unpack(ret, 2, count) end
        error(ret[2], 0)
    end
end

-- Swap one callback's wrappers back to their original handlers, keeping each priority.
local function reset_handlers(map, handlers)
    for wrapper, original in pairs(map) do
        local prio = handlers[wrapper]
        if prio ~= nil then handlers[original] = prio; handlers[wrapper] = nil end
    end
end

-- Swap every wrapper back to its original handler; safe on a partial arm and safe to call twice.
local function reset_callbacks()
    if not intercepts_ref then return end
    for name, map in pairs(callbacks.saved) do
        local handlers = intercepts_ref[name]
        if handlers then reset_handlers(map, handlers) end
    end
    callbacks.saved = {}
end

--- Arm the callbacks profiler: wrap every registered function handler in place. Play, then stop_callbacks().
--- @novalidate(code.unused_export, reason:"console command + panel control surface")
function start_callbacks()
    if callbacks.active then log("JitProfiler/callbacks: already running."); return end
    if cpu.active then log("JitProfiler/callbacks: CPU profiler is running -- JitProfiler.stop_cpu() first."); return end
    if alloc.capturing then log("JitProfiler/callbacks: allocation profiler is running -- JitProfiler.stop_alloc() first."); return end
    if scan.active then log("JitProfiler/callbacks: scanner is running -- JitProfiler.stop_scan() first."); return end
    if not resolve_intercepts() then log("!JitProfiler/callbacks: make_callback intercepts not reachable on this build; inert."); return end
    callbacks.records, callbacks.saved, callbacks.sp, callbacks.wrapped = {}, {}, 0, 0
    callbacks.t0, callbacks.active = get_time_ms(), true
    local pick = next(callbacks.set) ~= nil
    for name, handlers in pairs(intercepts_ref) do
        local to_wrap = (not pick or callbacks.set[name]) and collect_handlers(handlers) or {}
        for i = 1, #to_wrap do
            local handler, prio = to_wrap[i][1], to_wrap[i][2]
            local hframe = get_handler_frame(handler)
            local rec = { callback = name, handler = hframe, calls = 0, self_us = 0, total_us = 0, min_us = math.huge, max_us = 0 }
            callbacks.records[name .. tostring(handler)] = rec
            local wrapper = build_callbacks_wrapper(rec, handler)
            handlers[wrapper] = prio
            handlers[handler] = nil
            callbacks.saved[name] = callbacks.saved[name] or {}
            callbacks.saved[name][wrapper] = handler
            callbacks.wrapped = callbacks.wrapped + 1
        end
    end
    log("JitProfiler/callbacks: wrapping %d handlers%s. Play, then JitProfiler.stop_callbacks().", callbacks.wrapped, pick and " (picked callbacks only)" or "")
    show_tip(format("JitProfiler CALLBACKS %d handlers", callbacks.wrapped))
end

--- Restore every handler and write the report.
--- @novalidate(code.unused_export, reason:"console command + panel control surface")
function stop_callbacks()
    if not callbacks.active then log("JitProfiler/callbacks: not running."); return end
    callbacks.active = false
    reset_callbacks()
    callbacks.sp = 0
    last_capture.callbacks = jitprofiler_report.write_callbacks(callbacks.records, callbacks.wrapped, (get_time_ms() - callbacks.t0) / 1000.0)
    show_tip("JitProfiler CALLBACKS report written")
end

--- @novalidate(code.unused_export, reason:"panel control surface")
function is_callbacks_active()
    return callbacks.active
end

--- Add a callback to the picker set; the next start_callbacks arms only picked callbacks (empty set = all).
--- @novalidate(code.unused_export, reason:"panel control surface")
function add_callback_target(name)
    if tostring(name or "") ~= "" then callbacks.set[tostring(name)] = true end
end

--- Remove a callback from the picker set.
--- @novalidate(code.unused_export, reason:"panel control surface")
function remove_callback_target(name)
    callbacks.set[tostring(name or "")] = nil
end

--- @return boolean whether a callback is in the picker set.
--- @novalidate(code.unused_export, reason:"panel control surface")
function is_callback_target(name)
    return callbacks.set[tostring(name or "")] == true
end

--- @return number the count of picked callbacks; 0 means every callback arms.
--- @novalidate(code.unused_export, reason:"panel control surface")
function get_callback_pick_count()
    local count = 0
    for _ in pairs(callbacks.set) do count = count + 1 end
    return count
end

--- @return table the registered callbacks from the make_callback intercepts, sorted { name, handlers } rows; {} when unreachable.
--- @novalidate(code.unused_export, reason:"panel control surface")
function get_registered_callbacks()
    if not resolve_intercepts() then return {} end
    local list = {}
    for name, handlers in pairs(intercepts_ref) do
        list[#list + 1] = { name = name, handlers = #collect_handlers(handlers) }
    end
    table.sort(list, function(left, right) return left.name < right.name end)
    return list
end

-- Per-frame heartbeat: count scan frames, auto-stop a capture at its duration limit, auto-snapshot before the alloc table fills. Near-free when idle.
local function update_capture()
    if scan.active then
        scan.frames = scan.frames + 1
        if scan.limit > 0 and (get_time_ms() - scan.t0) / 1000 >= scan.limit then stop_scan() end
        return
    end
    if cpu.active then
        if cpu.limit > 0 and (get_time_ms() - cpu.t0) / 1000 >= cpu.limit then stop_cpu() end
        return
    end
    if not alloc.capturing then return end
    local usage = allocprof.usage()
    if usage > (alloc.peak or 0) then alloc.peak = usage end
    if alloc.limit > 0 and (get_time_ms() - alloc.t0) / 1000 >= alloc.limit then stop_alloc(); return end
    if usage >= alloc.snap_pct then write_snapshot(true) end
end
-- Fold the baseline rows (anomaly, modded exes, engine, unknown) out of the owned views, read at the next report.
function set_fold_baseline(on)
    fold_override = on and true or false
    log("JitProfiler: fold baseline = %s (applies to the next report)", tostring(fold_override))
end

--- @return table|nil the retained aggregate for kind "cpu" or "mem", or nil when nothing was captured yet.
function get_last_capture(kind)
    return last_capture[kind]
end

--- @return number|boolean the current session value for a capture setting.
function get_setting(key)
    return settings[key]
end

--- Store a session capture setting edited from the panel; never persisted.
function set_setting(key, value)
    settings[key] = value
end

-- Reduce a frame to name@<scripts-relative path>:line; a frame with no file token returns unchanged. Global so jitprofiler_report can normalise frames.
function get_short_frame(frame)
    local file = frame:match("([%w_%.%-\\/]+%.script:%-?%d+)")
              or frame:match("([%w_%.%-\\/]+%.lua:%-?%d+)")
              or frame:match("(%[C%]:%-?%d+)")
    if not file then return frame end
    file = file:gsub("\\", "/"):gsub("^.*/scripts/", ""):gsub("^%.%.%.[^/]*/", "")
    local name = frame:match("^([%w_]+)@")
    return name and (name .. "@" .. file) or file
end

--- @return string the owner (mod / modded exes / anomaly / engine / unknown) for a view key, resolved through the script it names.
function get_owner(key)
    if key:find("%[C%]") or key:find("%[GC%]") or key:find("%[JIT%]") then return OWNER_ENGINE end
    if is_string_frame(key) then return OWNER_STRING end
    local script_file = get_script_id(key)
    return script_file and get_script_owner(script_file) or OWNER_UNKNOWN
end

--- @return string the owner with an "(override: <file>)" note when a mod serves a vanilla-named script, for row display only.
function get_owner_label(key)
    local owner = get_owner(key)
    if owner:sub(1, #OWNER_MOD) ~= OWNER_MOD then return owner end
    local script_file = get_script_id(key)
    if script_file and jitprofiler_names.is_vanilla(script_file) then
        return owner .. " (override: " .. script_file .. ")"
    end
    return owner
end

--- @return string how the owner was decided: mod / loose / packed / name (see get_script_owner); "?" for pseudo-frames.
function get_owner_method(key)
    local script_file = get_script_id(key)
    return (script_file and origin_method[script_file]) or "?"
end

--- @return boolean whether the FFI real-path resolver is active; false means every owner is a name-guess.
function is_resolve_ready()
    return resolve_ready
end

function is_cpu_active()
    return cpu.active
end

function is_mem_active()
    return alloc.capturing
end

--- @return table|nil { elapsed, limit } in seconds for the running capture, or nil when idle.
function get_capture_progress()
    if cpu.active then return { elapsed = (get_time_ms() - cpu.t0) / 1000, limit = cpu.limit } end
    if alloc.capturing then return { elapsed = (get_time_ms() - alloc.t0) / 1000, limit = alloc.limit } end
    if scan.active then return { elapsed = (get_time_ms() - scan.t0) / 1000, limit = scan.limit } end
    if callbacks.active then return { elapsed = (get_time_ms() - callbacks.t0) / 1000, limit = callbacks.limit } end
    return nil
end

--- @return number|nil the allocation-table fill percentage while a MEM capture runs, else nil.
function get_alloc_usage()
    return alloc.capturing and allocprof.usage() or nil
end


-- The chunk executes twice (see the _G capture anchor above), so guard the one-time callback registration.
function on_game_start()
    if rawget(_G, "__jitprofiler_started") then return end
    rawset(_G, "__jitprofiler_started", true)
    RegisterScriptCallback("actor_on_update", update_capture)
    RegisterScriptCallback("on_before_level_changing", function() if callbacks.active then stop_callbacks() end end)
    RegisterScriptCallback("actor_on_net_destroy", function() if callbacks.active then stop_callbacks() end end)
    log("JitProfiler ready.  CPU: start_cpu([ms],[depth]) / stop_cpu().  ALLOC: start_alloc([depth]) / write_snapshot() / stop_alloc().")
    log("JitProfiler: SCAN start_scan(\"script\") / stop_scan() times every function of one script (engine C included).")
    log("JitProfiler: set_fold_baseline(true) folds the vanilla baseline.  Reports go to appdata/logs/jitprofiler_*.")
end
