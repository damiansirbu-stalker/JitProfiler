--- jf_mcm: MCM about page for JitProfiler, the ImGui overlay toggle, and the version footer.

defaults = {
    show_imgui = true,
    publish_repo = "",
    publish_branch = "",
    publish_token = "",
}

local RegisterScriptCallback = RegisterScriptCallback

local function build_path(key)
    return "jf/" .. key
end

cfg, get_config, load_config = xmcm.create_config("jf", defaults, build_path)

function on_mcm_load()
    return {
        id = "jf",
        sh = true,
        gr = {
            { id = "title", type = "slide", link = "jf_mcm_banner",
                text = "ui_mcm_jf_title", size = {512, 50}, spacing = 20 },
            { id = "desc", type = "desc", text = "ui_mcm_jf_desc" },
            { id = "usage", type = "desc", text = "ui_mcm_jf_usage" },
            { id = "speedscope", type = "desc", text = "ui_mcm_jf_speedscope" },
            { id = "div_toggle", type = "line" },
            { id = "show_imgui", type = "check", val = 1, def = true },
            { id = "div_publish", type = "line" },
            { id = "publish_title", type = "title", text = "ui_mcm_jf_publish" },
            { id = "publish_info", type = "desc", text = "ui_mcm_jf_publish_desc" },
            { id = "publish_repo", type = "input", val = 0, def = "" },
            { id = "publish_branch", type = "input", val = 0, def = "" },
            { id = "publish_token", type = "input", val = 0, def = "" },
            { id = "div_footer", type = "line" },
            { id = "platform", type = "desc", text = "ui_mcm_xmcm_footer",
                ui_hook_functor = { _jitprofiler_init.get_platform_functor() }, clr = {255, 212, 201, 168} },
        },
    }
end

function on_game_start()
    load_config()
    RegisterScriptCallback("on_option_change", load_config)
    RegisterScriptCallback("mcm_option_restore_default", load_config)
end
