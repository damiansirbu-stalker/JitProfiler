--- jitprofiler_ui: in-game ImGui panel plus a running banner over the last JitProfiler capture; opens from the ImGui menu bar.
local ImGui, JitProfiler, jitprofiler_report = ImGui, JitProfiler, jitprofiler_report
local ImGuiCond, ImGuiWindowFlags, ImGuiCol = ImGuiCond, ImGuiWindowFlags, ImGuiCol
local ImGuiTableFlags, ImGuiSelectableFlags = ImGuiTableFlags, ImGuiSelectableFlags
local vector2, fcolor, bit = vector2, fcolor, bit
local rawget, rawset = rawget, rawset
local pairs, math, table, pcall = pairs, math, table, pcall
local floor = math.floor
local format, RegisterScriptCallback = string.format, RegisterScriptCallback
local time_global, get_console, tonumber = time_global, get_console, tonumber
-- Rolling GC-collection rate: cycle count and time at the last 1-second sample, and the derived per-second rate.
local gc_c0, gc_t0, gc_rate = 0, 0, 0
-- jit.util.gcstat exists only on a profiler build; nil elsewhere, so the GC-health strip stays hidden.
local gcstat_fn = jit and jit.util and jit.util.gcstat

local WINDOW_W = 840
local WINDOW_H = 460
local SCREEN_FRAC = 0.9
local DETAIL_H = 190
local VMBAR_W  = 130
local BAR_W    = 80
local FILTER_W = 180
local TOP_NEIGHBORS = 8
local BYTES_PER_MB  = 1048576
local BYTES_PER_KB  = 1024
local OWNER_MOD = "mod: "
local KIND_CPU = "cpu"
local KIND_MEM = "mem"
local KIND_SCAN = "scan"
local KIND_CALLBACKS = "callbacks"
local KIND_PUBLISH = "publish"
local VIEW_BY_MOD = "by_mod"
local VIEW_BY_SCRIPT = "by_script"
local SORT_NAME = "name"
local SORT_OWNER = "owner"
local SORT_OWN = "own"
local SORT_TOTAL = "total"
local SORT_VALUE = "value"
local PCT_OWN = "Own %"
local PCT_TOTAL = "Total %"
local GC_RATE_MS = 1000

local COLOR_BG     = fcolor():set(0.09, 0.10, 0.12, 0.97)
local COLOR_TEXT   = fcolor():set(0.86, 0.89, 0.94, 1.0)
local COLOR_DIM    = fcolor():set(0.22, 0.24, 0.28, 1.0)
local COLOR_ACCENT = fcolor():set(0.26, 0.52, 0.85, 1.0)
local COLOR_RUN    = fcolor():set(0.90, 0.35, 0.35, 1.0)
local COLOR_WARN   = fcolor():set(0.85, 0.70, 0.35, 1.0)
-- Muted Anomaly amber for table headers: static chrome only, dimmer than COLOR_WARN so warnings stay louder; hover stays blue.
local COLOR_HEADER = fcolor():set(0.72, 0.58, 0.32, 1.0)
-- Reused fcolor for the single-hue blue heat ramp, lerped dim-to-bright by share in get_heat_color.
local HEAT_COLOR   = fcolor():set(0.26, 0.52, 0.85, 1.0)

-- Cached sizes so the render path allocates no vectors per frame; the scratch vectors below are mutated in place, never reallocated.
local VZERO       = vector2(0, 0)
local BAR_SIZE    = vector2(BAR_W, 0)
local VMBAR_SIZE  = vector2(VMBAR_W, 0)
local BTN_SIZE    = vector2(96, 0)
local BANNER_POS  = vector2(24, 120)
-- Scratch vectors reused every frame: the window size/pos derived from the live screen, and each scroll region's fill height.
local WIN_SIZE  = vector2(WINDOW_W, WINDOW_H)
local WIN_POS   = vector2(60, 60)
local FILL_SIZE = vector2(0, 0)

-- The CPU VM-state strip, one colored bar per state code in cap.meta.vmstate, explained on hover.
local VMSTATE = {
    { code = "N", label = "native",      color = fcolor():set(0.46, 0.80, 0.46, 1),
      tip = "JIT-compiled Lua running as native code." },
    { code = "I", label = "interpreter", color = fcolor():set(0.85, 0.80, 0.40, 1),
      tip = "Interpreted Lua running; a high share means the JIT skipped the hot code." },
    { code = "C", label = "C / engine",  color = fcolor():set(0.45, 0.65, 0.90, 1),
      tip = "Time in engine C, triggered by whatever script sits on the stack, or the engine itself when no script owns it." },
    { code = "G", label = "GC",          color = fcolor():set(0.90, 0.45, 0.45, 1),
      tip = "Garbage collection; a high share means allocation pressure, so switch to MEM to find the allocator." },
    { code = "J", label = "JIT compile", color = fcolor():set(0.75, 0.55, 0.85, 1),
      tip = "The JIT compiler working; a spike means traces recompiling." },
}

-- The selectable views over a retained capture; BY MOD and BY SCRIPT show Own + Total columns, frame views drill down. Each names its default sort column.
local VIEWS = {
    { key = VIEW_BY_MOD,    label = "BY MOD",    dual = true, own_key = "by_mod",    total_key = "by_mod_total",    default_sort = SORT_TOTAL },
    { key = VIEW_BY_SCRIPT, label = "BY SCRIPT", dual = true, own_key = "by_script", total_key = "by_script_total", default_sort = SORT_TOTAL },
    { key = "leaf",         label = "BY LEAF",   frame_keyed = true,  pct_label = PCT_OWN,   default_sort = SORT_VALUE },
    { key = "root",         label = "BY ROOT",   frame_keyed = true,  pct_label = PCT_TOTAL, default_sort = SORT_VALUE },
}

local WF = ImGuiWindowFlags
local BANNER_FLAGS = bit.bor(WF.NoTitleBar, WF.NoResize, WF.NoMove, WF.NoSavedSettings,
    WF.AlwaysAutoResize, WF.NoFocusOnAppearing, WF.NoInputs, WF.NoNav)
local TABLE_FLAGS = bit.bor(ImGuiTableFlags.RowBg, ImGuiTableFlags.BordersInnerH, ImGuiTableFlags.ScrollY)
local SPAN_ALL = ImGuiSelectableFlags.SpanAllColumns

local panel_open = false
local active_tab = KIND_CPU
-- default view BY SCRIPT: its rows carry the +/- add-to-instrumentation button
local view_index = 2
local fold_baseline = false
local filter_text = ""
local samp_sort = { field = SORT_TOTAL, asc = false }
local selected_frame = nil
local selected_neighbors = nil
local rows_sig, rows_cache
local mod_colors = {}

local mono_ok = false
local mono_checked = false

-- The panel ships JetBrains Mono at the engine's default 16px; an absent atlas resolves to the default face at the same size, so push unconditionally.
--- @safety SAFE - PushFont resolves a missing name to the default font (script_imgui_inline.h:441 -> ImGui NULL-default), so the push never faults.
local function init_mono()
    if mono_checked then return end
    mono_checked = true
    mono_ok = pcall(ImGui.PushFont, "jf_mono")
    if mono_ok then ImGui.PopFont() end
end
local function push_mono() if mono_ok then ImGui.PushFont("jf_mono") end end
local function pop_mono() if mono_ok then ImGui.PopFont() end end

-- One line of text in a pushed colour, popped after: the panel's most repeated idiom.
local function render_colored_text(color, text)
    ImGui.PushStyleColor(ImGuiCol.Text, color)
    ImGui.Text(text)
    ImGui.PopStyleColor(1)
end

-- A right-aligned white number cell: push the cursor to the cell's right edge minus the text width so magnitude lines up as a column.
local function render_num(text)
    ImGui.TableNextColumn()
    local pad = ImGui.GetContentRegionAvail().x - ImGui.CalcTextSize(text).x
    if pad > 0 then ImGui.SetCursorPosX(ImGui.GetCursorPosX() + pad) end
    render_colored_text(COLOR_TEXT, text)
end

-- Size a scroll region: frac takes that fraction of the remaining height, else fill minus reserve; floored so a short window never collapses it.
local function get_fill_size(reserve, frac)
    local avail = ImGui.GetContentRegionAvail().y
    local height = frac and (avail * frac) or (avail - (reserve or 0))
    local min_height = ImGui.GetTextLineHeightWithSpacing() * 3
    if height < min_height then height = min_height end
    FILL_SIZE:set(0, height)
    return FILL_SIZE
end

-- Open the panel at SCREEN_FRAC of the live screen (vid_mode is the player's current resolution), centered, on appear; the user resizes freely after.
local function set_window_size()
    local con = get_console()
    local mode = (con and con:get_string("vid_mode")) or ""
    local sw, sh = mode:match("(%d+)x(%d+)")
    if sw then
        local width, height = tonumber(sw), tonumber(sh)
        WIN_SIZE:set(floor(width * SCREEN_FRAC), floor(height * SCREEN_FRAC))
        WIN_POS:set(floor(width * (1 - SCREEN_FRAC) / 2), floor(height * (1 - SCREEN_FRAC) / 2))
        ImGui.SetNextWindowPos(WIN_POS, ImGuiCond.Appearing)
    end
    ImGui.SetNextWindowSize(WIN_SIZE, ImGuiCond.Appearing)
end

-- Stable per-mod colour from a name hash, bright enough to read on the dark background.
local function get_mod_color(name)
    local color = mod_colors[name]
    if color then return color end
    local hash = 0
    for i = 1, #name do hash = (hash * 131 + name:byte(i)) % 1000000007 end
    local red   = 0.55 + (hash % 100) / 100 * 0.28
    local green = 0.60 + (floor(hash / 100) % 100) / 100 * 0.28
    local blue  = 0.70 + (floor(hash / 10000) % 100) / 100 * 0.28
    color = fcolor():set(red, green, blue, 1.0)
    mod_colors[name] = color
    return color
end

local function check_filter(key, owner)
    if filter_text == "" then return true end
    local needle = filter_text:lower()
    return (key and key:lower():find(needle, 1, true)) or (owner and owner:lower():find(needle, 1, true)) or false
end

-- Draw every row of an open table, then close it. The table's own ScrollY bounds the height, so a long list scrolls instead of flooding.
local function render_table_rows(entries, draw)
    for i = 1, #entries do draw(entries[i]) end
    ImGui.EndTable()
end

-- Value a row sorts by for the active column: name and owner are strings, own/total/value are the weights.
local function sort_key(entry)
    local col = samp_sort.field
    if col == SORT_NAME then return entry.key end
    if col == SORT_OWNER then return entry.owner or "" end
    if col == SORT_OWN then return entry.own or entry.value or 0 end
    if col == SORT_TOTAL then return entry.total or entry.value or 0 end
    return entry.value or entry.total or 0
end

local function sort_rows(entries)
    local asc = samp_sort.asc
    table.sort(entries, function(left, right)
        local lv, rv = sort_key(left), sort_key(right)
        if asc then return lv < rv end
        return lv > rv
    end)
end

-- The retained capture is static, so build, resolve owners, and sort each row once per tab/view/sort/capture, not per frame.
local function get_rows(cap)
    local view = VIEWS[view_index]
    local sig = active_tab .. ":" .. view_index .. ":" .. samp_sort.field .. ":" .. (samp_sort.asc and "a" or "d") .. ":" .. (cap.meta.stamp or "?")
    if sig == rows_sig then return rows_cache end
    local entries = {}
    if view.dual then
        local total_map, own_map = cap.views[view.total_key], cap.views[view.own_key]
        local by_mod = (view.key == VIEW_BY_MOD)
        for key, total in pairs(total_map) do
            entries[#entries + 1] = { key = key, total = total, own = own_map[key] or 0,
                                      owner = by_mod and key or JitProfiler.get_owner(key) }
        end
    else
        local map = cap.views[view.key]
        for key, weight in pairs(map) do
            entries[#entries + 1] = { key = key, value = weight, owner = JitProfiler.get_owner(key) }
        end
    end
    sort_rows(entries)
    rows_cache, rows_sig = entries, sig
    selected_frame, selected_neighbors = nil, nil
    return entries
end

local function format_weight(kind, value)
    if kind ~= KIND_MEM then return format("%d", value) end
    if value >= BYTES_PER_MB then return format("%.1f MB", value / BYTES_PER_MB) end
    if value >= BYTES_PER_KB then return format("%.1f KB", value / BYTES_PER_KB) end
    return format("%.0f B", value)
end

local function format_clock(sec)
    local whole = floor(sec)
    return format("%d:%02d", floor(whole / 60), whole % 60)
end

-- Blue heat colour for a share: dim at low, bright at high, monotonic in luminance. Reuses HEAT_COLOR, no per-row allocation.
local function get_heat_color(pct)
    local frac = pct / 100
    if frac > 1 then frac = 1 elseif frac < 0 then frac = 0 end
    HEAT_COLOR:set(0.20 + 0.20 * frac, 0.34 + 0.34 * frac, 0.50 + 0.45 * frac, 1.0)
    return HEAT_COLOR
end

-- Fixed-width bar with the percent as text beside it, so the number sits on the dark background at a consistent spot.
local function render_bar(pct)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, get_heat_color(pct))
    ImGui.ProgressBar(pct / 100, BAR_SIZE, format("%.1f%%", pct))
    ImGui.PopStyleColor(1)
end

-- Clickable table header: an invisible full-cell button takes the click; the label draws over it, right-aligned, with a ^/v arrow on the active column.
local function render_header(state, prefix, label, field, right)
    ImGui.TableNextColumn()
    local start_x = ImGui.GetCursorPosX()
    local avail = ImGui.GetContentRegionAvail().x
    if avail < 1 then avail = 1 end
    if ImGui.InvisibleButton("##" .. prefix .. label, vector2(avail, 20)) then
        if state.field == field then state.asc = not state.asc else state.field, state.asc = field, false end
    end
    local hovered = ImGui.IsItemHovered()
    local shown = (state.field == field) and (label .. (state.asc and " ^" or " v")) or label
    ImGui.SameLine()
    local pad = right and (avail - ImGui.CalcTextSize(shown).x) or 0
    if pad < 0 then pad = 0 end
    ImGui.SetCursorPosX(start_x + pad)
    ImGui.PushStyleColor(ImGuiCol.Text, hovered and COLOR_ACCENT or COLOR_HEADER)
    ImGui.Text(shown)
    ImGui.PopStyleColor(1)
end
local function render_sort_header(label, col, right) render_header(samp_sort, "h", label, col, right) end

local function render_tooltip(cap, key, owner, weight)
    if not ImGui.IsItemHovered() then return end
    ImGui.SetTooltip(format("%s\n%s\nresolve: %s\n%s", JitProfiler.compute_masked_name(key), JitProfiler.compute_masked_name(owner),
        JitProfiler.get_owner_method(key), format_weight(cap.kind, weight)))
end

local function select_frame(cap, key)
    selected_frame = key
    selected_neighbors = key and jitprofiler_report.compute_neighbors(cap, key) or nil
end

-- The Start/Stop button inside the open CPU or MEM tab; grays out while another capture runs, since the three are mutually exclusive.
-- The Start/Stop run control shared by every capture tab: Stop while this runs, a disabled Start while another capture runs, else Start that fires start_fn.
local function render_run_button(id, this_on, other_on, start_fn, stop_fn)
    local label = this_on and "Stop" or "Start"
    if other_on and not this_on then
        ImGui.PushStyleColor(ImGuiCol.Button, COLOR_DIM)
        ImGui.Button(label .. "##" .. id, BTN_SIZE)
        ImGui.PopStyleColor(1)
        return
    end
    if ImGui.Button(label .. "##" .. id, BTN_SIZE) then
        if this_on then stop_fn() else start_fn() end
    end
end

-- Render helpers, the filter accessor, and cross-tab constants for jitprofiler_ui_trace; get_filter/set_filter keep one filter string across both files.
SHARED = {
    render_colored_text = render_colored_text,
    render_num = render_num,
    render_bar = render_bar,
    get_mod_color = get_mod_color,
    check_filter = check_filter,
    render_table_rows = render_table_rows,
    render_header = render_header,
    render_run_button = render_run_button,
    get_fill_size = get_fill_size,
    get_filter = function() return filter_text end,
    set_filter = function(text) filter_text = text end,
    TABLE_FLAGS = TABLE_FLAGS,
    DETAIL_H = DETAIL_H,
    TOP_NEIGHBORS = TOP_NEIGHBORS,
    FILTER_W = FILTER_W,
    VZERO = VZERO,
    COLOR_DIM = COLOR_DIM,
    COLOR_ACCENT = COLOR_ACCENT,
    KIND_SCAN = KIND_SCAN,
    KIND_CALLBACKS = KIND_CALLBACKS,
}

local function render_capture_button(kind)
    local this_on = (kind == KIND_CPU) and JitProfiler.is_cpu_active() or JitProfiler.is_mem_active()
    local other_on = ((kind == KIND_CPU) and JitProfiler.is_mem_active() or JitProfiler.is_cpu_active()) or JitProfiler.is_scan_active() or JitProfiler.is_callbacks_active()
    if kind == KIND_CPU then
        render_run_button("cap" .. kind, this_on, other_on, JitProfiler.start_cpu, JitProfiler.stop_cpu)
    else
        render_run_button("cap" .. kind, this_on, other_on, JitProfiler.start_alloc, JitProfiler.stop_alloc)
    end
end

-- Per-tab hover help: what each capture mode does.
local TAB_TIP = {
    [KIND_CPU]       = "CPU sampling. JIT stays on, near-zero overhead, whole modpack in one capture.",
    [KIND_MEM]       = "Allocation bytes, exact. JIT off so FPS drops; capture short. Finds the garbage.",
    [KIND_SCAN]      = "Wrap the scripts you pick and time each call, engine C included. Adds per-call cost.",
    [KIND_CALLBACKS] = "Time each registered handler over the callback dispatch. Opt-in.",
    [KIND_PUBLISH]   = "Push a masked capture to your GitHub Pages.",
}

-- One of the top tabs. While a capture runs, the tabs that are not the running one lock: dim and unclickable.
local function render_tab_button(kind, label)
    local sel = (active_tab == kind)
    local locked = not sel and (JitProfiler.is_cpu_active() or JitProfiler.is_mem_active() or JitProfiler.is_scan_active() or JitProfiler.is_callbacks_active())
    ImGui.PushStyleColor(ImGuiCol.Button, sel and COLOR_ACCENT or COLOR_DIM)
    if ImGui.Button(label .. "##tab", VZERO) and not locked and active_tab ~= kind then
        active_tab = kind
        selected_frame = nil
        selected_neighbors = nil
        jitprofiler_ui_trace.clear_selection()
    end
    if TAB_TIP[kind] and ImGui.IsItemHovered() then ImGui.SetTooltip(TAB_TIP[kind]) end
    ImGui.PopStyleColor(1)
end

-- The view selector as a dropdown: one box shows the current view; the other three stay hidden until it opens.
local function render_view_combo()
    ImGui.Text("View")
    ImGui.SameLine()
    ImGui.SetNextItemWidth(160)
    if not ImGui.BeginCombo("##view", VIEWS[view_index].label, 0) then return end
    for i = 1, #VIEWS do
        if ImGui.Selectable(VIEWS[i].label, i == view_index, 0, VZERO) and i ~= view_index then
            view_index = i
            samp_sort.field, samp_sort.asc = VIEWS[i].default_sort, false
            selected_frame = nil
            selected_neighbors = nil
        end
    end
    ImGui.EndCombo()
end

-- A baseline owner is any owner without the "mod: " prefix, i.e. not resolved to a specific mod.
local function is_baseline(owner)
    return owner:sub(1, #OWNER_MOD) ~= OWNER_MOD
end

local function render_bymod_row(cap, entry)
    local owner, own_weight, total_weight = entry.key, entry.own, entry.total
    if fold_baseline and is_baseline(owner) then return end
    if not check_filter(owner, owner) then return end
    local total = cap.total
    local own_pct = total > 0 and 100 * own_weight / total or 0
    local total_pct = total > 0 and 100 * total_weight / total or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    render_colored_text(get_mod_color(owner), JitProfiler.compute_masked_name(owner))
    if ImGui.IsItemHovered() then ImGui.SetTooltip(format("%s\n%s", JitProfiler.compute_masked_name(owner), format_weight(cap.kind, total_weight))) end
    ImGui.TableNextColumn()
    render_bar(own_pct)
    ImGui.TableNextColumn()
    render_bar(total_pct)
    render_num(format("%10s", format_weight(cap.kind, total_weight)))
    return true
end

local function render_bymod_table(cap)
    local entries = get_rows(cap)
    if not ImGui.BeginTable("jf_bymod", 4, TABLE_FLAGS, get_fill_size(selected_frame and DETAIL_H or 0), 0) then return end
    ImGui.TableSetupColumn("Mod", 0, 180, 0)
    ImGui.TableSetupColumn("Own %", 0, 80, 0)
    ImGui.TableSetupColumn("Total %", 0, 150, 0)
    ImGui.TableSetupColumn("Value", 0, 90, 0)
    ImGui.TableNextRow()
    render_sort_header("Mod", SORT_NAME)
    render_sort_header("Own %", SORT_OWN)
    render_sort_header("Total %", SORT_TOTAL)
    render_sort_header("Value", SORT_TOTAL, true)
    render_table_rows(entries, function(entry) return render_bymod_row(cap, entry) end)
end

local function render_view_row(cap, view, entry)
    local key, weight, owner = entry.key, entry.value, entry.owner
    if fold_baseline and is_baseline(owner) then return end
    if not check_filter(key, owner) then return end
    local pct = cap.total > 0 and 100 * weight / cap.total or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    if view.frame_keyed then
        local is_sel = (selected_frame == key)
        if ImGui.Selectable(JitProfiler.compute_masked_name(key) .. "##" .. key, is_sel, SPAN_ALL, VZERO) then
            select_frame(cap, is_sel and nil or key)
        end
    else
        ImGui.Text(JitProfiler.compute_masked_name(key))
    end
    render_tooltip(cap, key, owner, weight)
    ImGui.TableNextColumn()
    render_colored_text(get_mod_color(owner), JitProfiler.get_masked_label(key))
    ImGui.TableNextColumn()
    render_bar(pct)
    render_num(format("%10s", format_weight(cap.kind, weight)))
    return true
end

local function render_view_table(cap, view)
    local entries = get_rows(cap)
    local hint = view.pct_label == PCT_OWN and "Own % = innermost frame only; sums to ~100%" or "Total % = on the stack anywhere; exceeds 100%"
    render_colored_text(COLOR_DIM, hint)
    if not ImGui.BeginTable("jf_view", 4, TABLE_FLAGS, get_fill_size(selected_frame and DETAIL_H or 0), 0) then return end
    ImGui.TableSetupColumn("Frame", 0, 260, 0)
    ImGui.TableSetupColumn("Mod", 0, 150, 0)
    ImGui.TableSetupColumn("%", 0, 140, 0)
    ImGui.TableSetupColumn("Value", 0, 90, 0)
    ImGui.TableNextRow()
    render_sort_header("Frame", SORT_NAME)
    render_sort_header("Mod", SORT_OWNER)
    render_sort_header(view.pct_label or "%", SORT_VALUE)
    render_sort_header("Value", SORT_VALUE, true)
    render_table_rows(entries, function(entry) return render_view_row(cap, view, entry) end)
end

-- One BY SCRIPT row: the +/- instrument button and script name, the owner colour, then Own% and Total% bars with the raw value.
local function render_byscript_row(cap, entry)
    local key, own_weight, total_weight, owner = entry.key, entry.own, entry.total, entry.owner
    if fold_baseline and is_baseline(owner) then return end
    if not check_filter(key, owner) then return end
    local total = cap.total
    local own_pct = total > 0 and 100 * own_weight / total or 0
    local total_pct = total > 0 and 100 * total_weight / total or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    local on = JitProfiler.is_target(key)
    if ImGui.Button((on and "-##" or "+##") .. key, VZERO) then
        if on then JitProfiler.remove_target(key) else JitProfiler.add_target(key) end
    end
    if ImGui.IsItemHovered() then ImGui.SetTooltip("Add or remove this script from the instrument set.") end
    ImGui.SameLine()
    ImGui.Text(JitProfiler.compute_masked_name(key))
    render_tooltip(cap, key, owner, total_weight)
    ImGui.TableNextColumn()
    render_colored_text(get_mod_color(owner), JitProfiler.get_masked_label(key))
    ImGui.TableNextColumn()
    render_bar(own_pct)
    ImGui.TableNextColumn()
    render_bar(total_pct)
    render_num(format("%10s", format_weight(cap.kind, total_weight)))
    return true
end

-- BY SCRIPT: Own and Total side by side like BY MOD, each column sortable, with the per-row instrument button kept.
local function render_byscript_table(cap)
    local entries = get_rows(cap)
    render_colored_text(COLOR_DIM, "Own % = innermost frame (sums ~100%);  Total % = on the stack anywhere (exceeds 100%)")
    if not ImGui.BeginTable("jf_byscript", 5, TABLE_FLAGS, get_fill_size(selected_frame and DETAIL_H or 0), 0) then return end
    ImGui.TableSetupColumn("Function", 0, 210, 0)
    ImGui.TableSetupColumn("Mod", 0, 110, 0)
    ImGui.TableSetupColumn("Own %", 0, 70, 0)
    ImGui.TableSetupColumn("Total %", 0, 110, 0)
    ImGui.TableSetupColumn("Value", 0, 80, 0)
    ImGui.TableNextRow()
    render_sort_header("Function", SORT_NAME)
    render_sort_header("Mod", SORT_OWNER)
    render_sort_header("Own %", SORT_OWN)
    render_sort_header("Total %", SORT_TOTAL)
    render_sort_header("Value", SORT_TOTAL, true)
    render_table_rows(entries, function(entry) return render_byscript_row(cap, entry) end)
end

local function render_table(cap)
    local view = VIEWS[view_index]
    if view.key == VIEW_BY_MOD then render_bymod_table(cap)
    elseif view.key == VIEW_BY_SCRIPT then render_byscript_table(cap)
    else render_view_table(cap, view) end
end

local function render_ranked(title, list, total)
    render_colored_text(COLOR_DIM, title)
    if #list == 0 then ImGui.Text("  (none)"); return end
    for i = 1, math.min(#list, TOP_NEIGHBORS) do
        local pct = total > 0 and 100 * list[i][2] / total or 0
        ImGui.Text(format("  %5.1f%%  %s", pct, JitProfiler.compute_masked_name(list[i][1])))
    end
end

-- The stack neighbors of the selected frame, in the slice the table reserved: callers toward the root, callees toward the leaf.
local function render_neighbors(cap)
    if not (selected_frame and selected_neighbors) then return end
    ImGui.Separator()
    ImGui.Text("SELECTED  " .. JitProfiler.compute_masked_name(selected_frame))
    render_ranked("CALLERS (toward root)", selected_neighbors.callers, cap.total)
    render_ranked("CALLEES (toward leaf)", selected_neighbors.callees, cap.total)
end

local function render_vmstate_bar(state, weight, total)
    if weight <= 0 then return end
    local frac = weight / total
    local label_text = format("%-12s", state.label)
    render_colored_text(state.color, label_text)
    ImGui.SameLine(120)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, state.color)
    ImGui.ProgressBar(frac, VMBAR_SIZE, "")
    ImGui.PopStyleColor(1)
    if ImGui.IsItemHovered() then ImGui.SetTooltip(state.tip) end
    ImGui.SameLine()
    ImGui.Text(format("%.1f%%", frac * 100))
end

local function render_vmstate(cap)
    local vm = cap.meta.vmstate
    local total = cap.total
    if not vm or total <= 0 then return end
    for i = 1, #VMSTATE do
        render_vmstate_bar(VMSTATE[i], vm[VMSTATE[i].code] or 0, total)
    end
end

-- The Lua call sites that drove the most engine C/GC this capture: what to reduce, and where to point Optick.
local function render_engine_entry(cap)
    local list = cap.engine_entry
    if not list or #list == 0 then return end
    if not ImGui.CollapsingHeader("Engine-C entry points  (Lua call sites driving engine time; Optick targets)") then return end
    local total = cap.total
    for i = 1, math.min(#list, TOP_NEIGHBORS) do
        local key, weight = list[i][1], list[i][2]
        local pct = total > 0 and 100 * weight / total or 0
        local entry_text = format("  %5.1f%%  %s", pct, JitProfiler.compute_masked_name(key))
        render_colored_text(get_mod_color(JitProfiler.get_owner(key)), entry_text)
    end
end

-- One GC-health row: the label, a heat bar for the clamped fraction, then the value text.
local function render_gc_bar(label, frac, text)
    if frac > 1 then frac = 1 elseif frac < 0 then frac = 0 end
    ImGui.Text(format("%-10s", label))
    ImGui.SameLine(120)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, get_heat_color(frac * 100))
    ImGui.ProgressBar(frac, VMBAR_SIZE, "")
    ImGui.PopStyleColor(1)
    ImGui.SameLine()
    ImGui.Text(text)
end

-- Live LuaJIT GC health from jit.util.gcstat: a bar for the heap toward the next collection, then the live estimate and debt.
local function render_gc_health()
    if not gcstat_fn then return end
    local stat = gcstat_fn()
    local mb = 1 / BYTES_PER_MB
    render_gc_bar("GC heap", stat.threshold > 0 and stat.total / stat.threshold or 0,
        format("%.1f / %.1f MB to next GC", stat.total * mb, stat.threshold * mb))
    render_gc_bar("GC live", stat.total > 0 and stat.estimate / stat.total or 0, format("%.1f MB live", stat.estimate * mb))
    render_gc_bar("GC debt", stat.threshold > 0 and stat.debt / stat.threshold or 0, format("%.0f B behind", stat.debt))
    if stat.cycles then
        local now = time_global and time_global() or 0
        if gc_t0 == 0 then gc_t0, gc_c0 = now, stat.cycles end
        local dt = now - gc_t0
        if dt >= GC_RATE_MS then gc_rate = (stat.cycles - gc_c0) * GC_RATE_MS / dt; gc_t0, gc_c0 = now, stat.cycles end
        ImGui.Text(format("GC collections %.0f   ~%.1f/s", stat.cycles, gc_rate))
    end
end

-- On MT the CPU G% is inflated while parallel GC runs; this toggle flips lua_parallel_gc for a clean read. Hidden when the cvar is absent (single-thread exe).
local has_pgc
-- Whether the MT parallel-GC cvar exists and is on; drives both the checkbox and the CPU inflation warning.
local function is_pgc_on()
    if has_pgc == nil then has_pgc = get_console():get_string("lua_parallel_gc") ~= nil end
    return has_pgc and get_console():get_integer("lua_parallel_gc") ~= 0
end

local function render_pgc_toggle()
    if has_pgc == nil then has_pgc = get_console():get_string("lua_parallel_gc") ~= nil end
    if not has_pgc then return end
    local on = get_console():get_integer("lua_parallel_gc") ~= 0
    local _, new_on = ImGui.Checkbox("Parallel GC", on)
    if new_on ~= on then get_console():execute("lua_parallel_gc " .. (new_on and "1" or "0")) end
    if ImGui.IsItemHovered() then ImGui.SetTooltip("Off gives a clean CPU G%; the MT parallel GC inflates it.") end
end

-- The filter and fold row for a sampling tab, with the CPU-only Parallel GC toggle appended.
local function render_controls()
    ImGui.Text("Filter")
    ImGui.SameLine()
    ImGui.SetNextItemWidth(FILTER_W)
    local new_filter = ImGui.InputText("##filter", filter_text, 64)
    if new_filter then filter_text = new_filter end
    ImGui.SameLine(0, 20)
    fold_baseline = JitProfiler.get_setting("fold")
    local _, new_fold = ImGui.Checkbox("Fold baseline", fold_baseline)
    if ImGui.IsItemHovered() then ImGui.SetTooltip("Hide the non-mod rows (anomaly, modded exes, engine, unknown), leaving mods only.") end
    if new_fold ~= fold_baseline then JitProfiler.set_setting("fold", new_fold) end
    fold_baseline = new_fold
    if active_tab == KIND_CPU then
        ImGui.SameLine(0, 20)
        render_pgc_toggle()
    end
end


-- Depth, drop, and resolver warnings for a retained capture.
local function render_tab_health(cap)
    local at_cap = (cap.total > 0) and 100 * (cap.meta.clipped or 0) / cap.total or 0
    ImGui.Text(format("stack depth %d / cap %d   %.1f%% at cap",
        cap.meta.max_depth or 0, cap.meta.depth or 0, at_cap))
    local dropped = cap.meta.dropped or 0
    if dropped > 0 then
        ImGui.PushStyleColor(ImGuiCol.Text, COLOR_WARN)
        if cap.kind == KIND_CPU then
            ImGui.Text(format("dropped %d samples (stack table full)", dropped))
        else
            ImGui.Text(format("dropped %s (alloc table full)", format_weight(KIND_MEM, dropped)))
        end
        ImGui.PopStyleColor(1)
    end
    if not JitProfiler.is_resolve_ready() then
        ImGui.PushStyleColor(ImGuiCol.Text, COLOR_WARN)
        ImGui.Text("owner resolve unavailable (no FFI): mod names are name-guesses")
        ImGui.PopStyleColor(1)
    end
end

local function render_tab(cap)
    if cap.kind == KIND_CPU then
        ImGui.Text(format("%d samples   ~%.0fs   %s", cap.meta.samples or 0, cap.meta.duration or 0, cap.meta.stamp or "?"))
    else
        ImGui.Text(format("%s allocated   ~%.0fs   %s", format_weight(KIND_MEM, cap.total), cap.meta.duration or 0, cap.meta.stamp or "?"))
    end
    render_tab_health(cap)
    if cap.kind == KIND_CPU then
        ImGui.Separator()
        ImGui.PushStyleColor(ImGuiCol.Text, COLOR_DIM)
        ImGui.Text("VM state at each sample")
        ImGui.PopStyleColor(1)
        render_vmstate(cap)
        render_engine_entry(cap)
    end
    ImGui.Separator()
    render_table(cap)
    render_neighbors(cap)
end

-- The MCM toggle for the ImGui overlay; defaults to shown until the config loads. Cached table read, no per-frame ini parse.
local function is_overlay_enabled()
    local cfg = jf_mcm and jf_mcm.cfg
    return not cfg or cfg.show_imgui ~= false
end

-- Under the tabs: a red recording line while a capture runs, plus a CPU-tab caution when parallel GC would inflate the G%.
local function render_status_line()
    local prog = JitProfiler.get_capture_progress()
    if prog then
        local mode = JitProfiler.is_cpu_active() and "CPU" or (JitProfiler.is_mem_active() and "MEM" or (JitProfiler.is_scan_active() and "INSTRUMENT" or "CALLBACKS"))
        local line = "REC  " .. mode .. "  " .. format_clock(prog.elapsed)
        if prog.limit > 0 then line = line .. " / " .. format_clock(prog.limit) end
        render_colored_text(COLOR_RUN, line)
    end
    if active_tab == KIND_CPU and is_pgc_on() then
        render_colored_text(COLOR_WARN, "Parallel GC on: CPU GC% inflated. Uncheck Parallel GC below for a clean read.")
    end
    if JitProfiler.is_mem_active() then
        render_colored_text(COLOR_WARN, "JIT off for exact bytes: FPS drops HARD on a heavy modpack. Accuracy stays 100%; capture short.")
    elseif JitProfiler.is_scan_active() or JitProfiler.is_callbacks_active() then
        local note = "Wrapping adds per-call cost: FPS drops while capturing, accuracy stays 100%."
        render_colored_text(COLOR_DIM, note)
    end
end

-- A CPU or MEM tab: its own Start/Stop and Snapshot, the filter/fold/parallel-gc row, the view dropdown, then the retained capture.
local function render_sampling_body()
    render_capture_button(active_tab)
    if active_tab == KIND_MEM and JitProfiler.is_mem_active() then
        ImGui.SameLine()
        if ImGui.Button("Snapshot##snap", BTN_SIZE) then JitProfiler.write_snapshot() end
        if ImGui.IsItemHovered() then ImGui.SetTooltip("Dump the allocation so far to a numbered report and keep capturing.") end
        local usage = JitProfiler.get_alloc_usage and JitProfiler.get_alloc_usage()
        if usage then
            ImGui.SameLine(0, 20)
            ImGui.Text("alloc table")
            ImGui.SameLine()
            render_bar(usage)
        end
    end
    render_controls()
    render_view_combo()
    ImGui.Separator()
    if active_tab == KIND_MEM then
        render_gc_health()
        ImGui.Separator()
    end
    local cap = JitProfiler.get_last_capture(active_tab)
    if cap then
        render_tab(cap)
    else
        ImGui.Text("No capture yet.  Press Start, play, then Stop.")
    end
end

-- The profiling view under a capture tab: status line, the active kind's body, then the Settings footer.
local function render_active_view()
    render_status_line()
    ImGui.Separator()
    if active_tab == KIND_SCAN then
        jitprofiler_ui_trace.render_instrument()
    elseif active_tab == KIND_CALLBACKS then
        jitprofiler_ui_trace.render_callbacks()
    else
        render_sampling_body()
    end
    ImGui.Spacing()
    ImGui.Separator()
    jitprofiler_ui_config.render_footer()
end

local function render_panel()
    if not (panel_open and is_overlay_enabled()) then return end
    set_window_size()
    ImGui.PushStyleColor(ImGuiCol.WindowBg, COLOR_BG)
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, COLOR_ACCENT)
    local expanded, open = ImGui.Begin("JitProfiler", panel_open, 0)
    panel_open = open
    if expanded then
        init_mono()
        push_mono()
        render_tab_button(KIND_CPU, "CPU")
        ImGui.SameLine()
        render_tab_button(KIND_MEM, "MEM")
        ImGui.SameLine()
        render_tab_button(KIND_SCAN, "INSTRUMENT")
        ImGui.SameLine()
        render_tab_button(KIND_CALLBACKS, "CALLBACKS")
        ImGui.SameLine()
        render_tab_button(KIND_PUBLISH, "PUBLISH")
        if active_tab == KIND_PUBLISH then
            jitprofiler_ui_config.render_publish_tab()
        else
            render_active_view()
        end
        pop_mono()
    end
    ImGui.End()
    ImGui.PopStyleColor(3)
end

local function render_menu()
    if not is_overlay_enabled() then return end
    if not ImGui.BeginMenu("JitProfiler") then return end
    local _
    _, panel_open = ImGui.MenuItem("Panel", nil, panel_open, true)
    ImGui.EndMenu()
end

-- Always-on corner banner via the Unique group; renders every frame, shows only while a capture runs.
local function render_banner()
    if not is_overlay_enabled() then return end
    local cpu_on = JitProfiler.is_cpu_active()
    local scan_on = JitProfiler.is_scan_active()
    local cb_on = JitProfiler.is_callbacks_active()
    if not (cpu_on or JitProfiler.is_mem_active() or scan_on or cb_on) then return end
    local label = cpu_on and "CPU PROFILER" or (scan_on and "INSTRUMENT" or (cb_on and "CALLBACKS" or "MEM PROFILER"))
    local prog = JitProfiler.get_capture_progress()
    if prog then
        label = label .. "   " .. format_clock(prog.elapsed)
        if prog.limit > 0 then label = label .. " / " .. format_clock(prog.limit) end
    end
    ImGui.SetNextWindowPos(BANNER_POS, ImGuiCond.Always)
    ImGui.PushStyleColor(ImGuiCol.WindowBg, COLOR_BG)
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    local expanded = ImGui.Begin("##jf_banner", true, BANNER_FLAGS)
    if expanded then ImGui.Text(label) end
    ImGui.End()
    ImGui.PopStyleColor(2)
end

-- Register the panel, menu, and banner once the ImGui Groups API is present; the _G flag survives the chunk double-load.
local function try_init()
    if rawget(_G, "__jitprofiler_ui_registered") then return true end
    if not (ImGui and ImGui.Groups and ImGui.Groups.Widget) then return false end
    local widget = ImGui.Groups.Widget
    rawset(_G, "__jitprofiler_ui_registered", true)
    widget("MenuBar", render_menu)
    widget("Main", render_panel)
    widget("Unique", render_banner)
    return true
end

function on_game_start()
    if rawget(_G, "__jitprofiler_ui_started") then return end
    rawset(_G, "__jitprofiler_ui_started", true)
    RegisterScriptCallback("actor_on_update", try_init)
end
