--- jitprofiler_ui: in-game ImGui panel plus a running banner over the last JitProfiler capture; opens from the ImGui menu bar.
local ImGui, JitProfiler = ImGui, JitProfiler
local ImGuiCond, ImGuiWindowFlags, ImGuiCol = ImGuiCond, ImGuiWindowFlags, ImGuiCol
local ImGuiTableFlags, ImGuiSelectableFlags = ImGuiTableFlags, ImGuiSelectableFlags
local vector2, fcolor, bit = vector2, fcolor, bit
local rawget, rawset = rawget, rawset
local pairs, math, table, type, pcall = pairs, math, table, type, pcall
local floor = math.floor
local format, RegisterScriptCallback = string.format, RegisterScriptCallback
-- jit.util.gcstat exists only on a profiler build; nil elsewhere, so the GC-health strip stays hidden.
local gcstat_fn = jit and jit.util and jit.util.gcstat

local WINDOW_W = 640
local WINDOW_H = 460
local TABLE_H  = 240
local VMBAR_W  = 130
local BAR_W    = 80
local FILTER_W = 180
local VIEW_W   = 160
local TOP_NEIGHBORS = 8
local OVERHEAD_WARN = 4000
local FRAME_MS_60 = 1000 / 60
local BYTES_PER_MB  = 1048576
local BYTES_PER_KB  = 1024
local OWNER_MOD = "mod: "
local KIND_CPU = "cpu"
local KIND_MEM = "mem"
local KIND_SCAN = "scan"
local VIEW_BY_MOD = "by_mod"
local VIEW_BY_SCRIPT = "by_script_total"
local SORT_VALUE = "value"
local SORT_NAME = "name"

local COLOR_BG     = fcolor():set(0.09, 0.10, 0.12, 0.97)
local COLOR_TEXT   = fcolor():set(0.86, 0.89, 0.94, 1.0)
local COLOR_DIM    = fcolor():set(0.22, 0.24, 0.28, 1.0)
local COLOR_ACCENT = fcolor():set(0.26, 0.52, 0.85, 1.0)
-- Reused fcolor for the single-hue blue heat ramp, lerped dim-to-bright by share in get_heat_color.
local HEAT_COLOR   = fcolor():set(0.26, 0.52, 0.85, 1.0)

-- Cached sizes so the render path allocates no vectors per frame.
local VZERO       = vector2(0, 0)
local BAR_SIZE    = vector2(BAR_W, 0)
local VMBAR_SIZE  = vector2(VMBAR_W, 0)
local WINDOW_SIZE = vector2(WINDOW_W, WINDOW_H)
local TABLE_SIZE  = vector2(0, TABLE_H)
local BTN_SIZE    = vector2(96, 0)
local BANNER_POS  = vector2(24, 120)

-- The CPU VM-state strip, one colored bar per state code in cap.meta.vmstate, explained on hover.
local VMSTATE = {
    { code = "N", label = "native",      color = fcolor():set(0.46, 0.80, 0.46, 1),
      tip = "JIT-compiled Lua running as native code." },
    { code = "I", label = "interpreter", color = fcolor():set(0.85, 0.80, 0.40, 1),
      tip = "Interpreted Lua running; a high share means the JIT skipped the hot code." },
    { code = "C", label = "C / engine",  color = fcolor():set(0.45, 0.65, 0.90, 1),
      tip = "Time in engine C, triggered by whatever script sits on the stack, or the engine itself when no script owns it." },
    { code = "G", label = "GC",          color = fcolor():set(0.90, 0.45, 0.45, 1),
      tip = "Garbage collection; a high share means allocation pressure, so switch to MEM to find the allocator." },
    { code = "J", label = "JIT compile", color = fcolor():set(0.75, 0.55, 0.85, 1),
      tip = "The JIT compiler working; a spike means traces recompiling." },
}

-- The selectable views over a retained capture; BY MOD shows Own + Total columns, BY SCRIPT ranks by Total, frame views drill down.
local VIEWS = {
    { key = VIEW_BY_MOD,    label = "BY MOD",    frame_keyed = false },
    { key = VIEW_BY_SCRIPT, label = "BY SCRIPT", frame_keyed = false },
    { key = "leaf",         label = "BY LEAF",   frame_keyed = true },
    { key = "root",         label = "BY ROOT",   frame_keyed = true },
}

local WF = ImGuiWindowFlags
local BANNER_FLAGS = bit.bor(WF.NoTitleBar, WF.NoResize, WF.NoMove, WF.NoSavedSettings,
    WF.AlwaysAutoResize, WF.NoFocusOnAppearing, WF.NoInputs, WF.NoNav)
local TABLE_FLAGS = bit.bor(ImGuiTableFlags.RowBg, ImGuiTableFlags.BordersInnerH, ImGuiTableFlags.ScrollY)
local SPAN_ALL = ImGuiSelectableFlags.SpanAllColumns

local panel_open = false
local active_tab = KIND_CPU
local view_index = 1
local fold_baseline = false
local filter_text = ""
local sort_by = SORT_VALUE
local sort_asc = false
local scan_sort = "self_us"
local scan_sort_asc = false
local selected_frame = nil
local selected_neighbors = nil
local rows_sig, rows_cache
local mod_colors = {}

local MODE_SAMPLING = "sampling"
local MODE_INSTRUMENT = "instrument"
local active_mode = MODE_SAMPLING
local INST_SELECTED = "selected"
local INST_BROWSE = "browse"
local inst_view = INST_SELECTED
local tree_search = ""
local tree_cache
local mono_ok = false
local mono_checked = false

-- The panel ships JetBrains Mono at the engine's default 16px; an absent atlas resolves to the default face at the same size, so push unconditionally.
--- @safety SAFE - PushFont resolves a missing name to the default font (script_imgui_inline.h:441 -> ImGui NULL-default), so the push never faults.
local function init_mono()
    if mono_checked then return end
    mono_checked = true
    mono_ok = pcall(ImGui.PushFont, "jf_mono")
    if mono_ok then ImGui.PopFont() end
end
local function push_mono() if mono_ok then ImGui.PushFont("jf_mono") end end
local function pop_mono() if mono_ok then ImGui.PopFont() end end

-- A right-aligned white number cell: push the cursor to the cell's right edge minus the text width so magnitude lines up as a column.
local function render_num(text)
    ImGui.TableNextColumn()
    local pad = ImGui.GetContentRegionAvail().x - ImGui.CalcTextSize(text).x
    if pad > 0 then ImGui.SetCursorPosX(ImGui.GetCursorPosX() + pad) end
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    ImGui.Text(text)
    ImGui.PopStyleColor(1)
end

-- Stable per-mod colour from a name hash, bright enough to read on the dark background.
local function get_mod_color(name)
    local color = mod_colors[name]
    if color then return color end
    local hash = 0
    for i = 1, #name do hash = (hash * 131 + name:byte(i)) % 1000000007 end
    local red   = 0.55 + (hash % 100) / 100 * 0.28
    local green = 0.60 + (floor(hash / 100) % 100) / 100 * 0.28
    local blue  = 0.70 + (floor(hash / 10000) % 100) / 100 * 0.28
    color = fcolor():set(red, green, blue, 1.0)
    mod_colors[name] = color
    return color
end

local function check_filter(key, owner)
    if filter_text == "" then return true end
    local needle = filter_text:lower()
    return (key and key:lower():find(needle, 1, true)) or (owner and owner:lower():find(needle, 1, true)) or false
end

local function sort_rows(entries)
    if sort_by == SORT_NAME then
        table.sort(entries, function(left, right)
            if sort_asc then return left[1] < right[1] end
            return left[1] > right[1]
        end)
    else
        table.sort(entries, function(left, right)
            if sort_asc then return left[2] < right[2] end
            return left[2] > right[2]
        end)
    end
end

-- The retained capture is static, so sort and resolve each row's owner once per tab/view/sort/capture, not per frame.
local function get_rows(cap)
    local view = VIEWS[view_index]
    local sig = active_tab .. ":" .. view_index .. ":" .. sort_by .. ":" .. (sort_asc and "a" or "d") .. ":" .. (cap.meta.stamp or "?")
    if sig == rows_sig then return rows_cache end
    local entries = {}
    local map = (view.key == VIEW_BY_MOD) and cap.views.by_mod_total or cap.views[view.key]
    for key, weight in pairs(map) do entries[#entries + 1] = { key, weight } end
    if view.key ~= VIEW_BY_MOD then
        for i = 1, #entries do entries[i][3] = JitProfiler.get_owner(entries[i][1]) end
    end
    sort_rows(entries)
    rows_cache, rows_sig = entries, sig
    selected_frame, selected_neighbors = nil, nil
    return entries
end

local function format_weight(kind, value)
    if kind ~= KIND_MEM then return format("%d", value) end
    if value >= BYTES_PER_MB then return format("%.1f MB", value / BYTES_PER_MB) end
    if value >= BYTES_PER_KB then return format("%.1f KB", value / BYTES_PER_KB) end
    return format("%.0f B", value)
end

local function format_clock(sec)
    local whole = floor(sec)
    return format("%d:%02d", floor(whole / 60), whole % 60)
end

-- Fixed-width bar with the percent as text beside it, so the number sits on the dark background at a consistent spot.
-- Amber heat colour for a share: dim at low, bright amber at high, monotonic in luminance. Reuses HEAT_COLOR, no per-row allocation.
local function get_heat_color(pct)
    local frac = pct / 100
    if frac > 1 then frac = 1 elseif frac < 0 then frac = 0 end
    HEAT_COLOR:set(0.20 + 0.20 * frac, 0.34 + 0.34 * frac, 0.50 + 0.45 * frac, 1.0)
    return HEAT_COLOR
end

local function render_bar(pct)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, get_heat_color(pct))
    ImGui.ProgressBar(pct / 100, BAR_SIZE, "")
    ImGui.PopStyleColor(1)
    ImGui.SameLine()
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    ImGui.Text(format("%.1f%%", pct))
    ImGui.PopStyleColor(1)
end

-- A clickable column header; the name column sorts by name, the rest by value, and a second click flips direction.
local function render_sort_header(label, dim)
    ImGui.TableNextColumn()
    if ImGui.Button(label .. "##h") then
        if sort_by == dim then sort_asc = not sort_asc else sort_by, sort_asc = dim, false end
    end
end

local function render_tooltip(cap, key, owner, weight)
    if not ImGui.IsItemHovered() then return end
    ImGui.SetTooltip(format("%s\n%s\n%s", key, owner, format_weight(cap.kind, weight)))
end

local function select_frame(cap, key)
    selected_frame = key
    selected_neighbors = key and JitProfiler.compute_neighbors(cap.kind, key) or nil
end

-- One capture-control button; grays out while the opposite axis runs, since the two are mutually exclusive.
local function render_capture_button(kind)
    local this_on = (kind == KIND_CPU) and JitProfiler.is_cpu_active() or JitProfiler.is_mem_active()
    local other_on = ((kind == KIND_CPU) and JitProfiler.is_mem_active() or JitProfiler.is_cpu_active()) or JitProfiler.is_scan_active()
    local label = (this_on and "Stop " or "Start ") .. ((kind == KIND_CPU) and "CPU" or "MEM")
    if other_on and not this_on then
        ImGui.PushStyleColor(ImGuiCol.Button, COLOR_DIM)
        ImGui.Button(label .. "##cap" .. kind, BTN_SIZE)
        ImGui.PopStyleColor(1)
        return
    end
    if not ImGui.Button(label .. "##cap" .. kind, BTN_SIZE) then return end
    if kind == KIND_CPU then
        if this_on then JitProfiler.stop_cpu() else JitProfiler.start_cpu() end
    elseif this_on then
        JitProfiler.stop_alloc()
    else
        JitProfiler.start_alloc()
    end
end

local function render_tab_button(kind, label)
    local sel = (active_tab == kind)
    ImGui.PushStyleColor(ImGuiCol.Button, sel and COLOR_ACCENT or COLOR_DIM)
    if ImGui.Button(label .. "##tab", BTN_SIZE) and active_tab ~= kind then
        active_tab = kind
        selected_frame = nil
        selected_neighbors = nil
    end
    ImGui.PopStyleColor(1)
end

-- The view selector as a dropdown: one box shows the current view; the other three stay hidden until it opens.
local function render_view_combo()
    ImGui.Text("View")
    ImGui.SameLine()
    ImGui.SetNextItemWidth(VIEW_W)
    if not ImGui.BeginCombo("##view", VIEWS[view_index].label, 0) then return end
    for i = 1, #VIEWS do
        if ImGui.Selectable(VIEWS[i].label, i == view_index, 0, VZERO) and i ~= view_index then
            view_index = i
            selected_frame = nil
            selected_neighbors = nil
        end
    end
    ImGui.EndCombo()
end

-- A baseline owner is anything not resolved to a specific mod: anomaly, modded exes, engine, unknown.
local function is_baseline(owner)
    return owner:sub(1, #OWNER_MOD) ~= OWNER_MOD
end

local function render_bymod_row(cap, entry, own_map)
    local owner, total_weight = entry[1], entry[2]
    if fold_baseline and is_baseline(owner) then return end
    if not check_filter(owner, owner) then return end
    local total = cap.total
    local own_pct = total > 0 and 100 * (own_map[owner] or 0) / total or 0
    local total_pct = total > 0 and 100 * total_weight / total or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    ImGui.PushStyleColor(ImGuiCol.Text, get_mod_color(owner))
    ImGui.Text(owner)
    ImGui.PopStyleColor(1)
    render_tooltip(cap, owner, owner, total_weight)
    ImGui.TableNextColumn()
    render_bar(own_pct)
    ImGui.TableNextColumn()
    render_bar(total_pct)
    render_num(format("%10s", format_weight(cap.kind, total_weight)))
end

local function render_bymod_table(cap)
    local own_map = cap.views.by_mod
    local entries = get_rows(cap)
    if not ImGui.BeginTable("jf_bymod", 4, TABLE_FLAGS, TABLE_SIZE, 0) then return end
    ImGui.TableSetupColumn("Mod", 0, 180, 0)
    ImGui.TableSetupColumn("Own %", 0, 80, 0)
    ImGui.TableSetupColumn("Total %", 0, 150, 0)
    ImGui.TableSetupColumn("Value", 0, 90, 0)
    ImGui.TableNextRow()
    render_sort_header("Mod", SORT_NAME)
    render_sort_header("Own %", SORT_VALUE)
    render_sort_header("Total %", SORT_VALUE)
    render_sort_header("Value", SORT_VALUE)
    for i = 1, #entries do render_bymod_row(cap, entries[i], own_map) end
    ImGui.EndTable()
end

local function render_view_row(cap, view, entry)
    local key, weight, owner = entry[1], entry[2], entry[3]
    if fold_baseline and is_baseline(owner) then return end
    if not check_filter(key, owner) then return end
    local pct = cap.total > 0 and 100 * weight / cap.total or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    if view.frame_keyed then
        local is_sel = (selected_frame == key)
        if ImGui.Selectable(key .. "##row", is_sel, SPAN_ALL, VZERO) then
            select_frame(cap, is_sel and nil or key)
        end
    elseif view.key == VIEW_BY_SCRIPT then
        local on = JitProfiler.is_target(key)
        if ImGui.Button((on and "-##" or "+##") .. key, VZERO) then
            if on then JitProfiler.remove_target(key) else JitProfiler.add_target(key) end
        end
        ImGui.SameLine()
        ImGui.Text(key)
    else
        ImGui.Text(key)
    end
    render_tooltip(cap, key, owner, weight)
    ImGui.TableNextColumn()
    ImGui.PushStyleColor(ImGuiCol.Text, get_mod_color(owner))
    ImGui.Text(JitProfiler.get_owner_label(key))
    ImGui.PopStyleColor(1)
    ImGui.TableNextColumn()
    render_bar(pct)
    render_num(format("%10s", format_weight(cap.kind, weight)))
end

local function render_view_table(cap, view)
    local entries = get_rows(cap)
    if not ImGui.BeginTable("jf_view", 4, TABLE_FLAGS, TABLE_SIZE, 0) then return end
    ImGui.TableSetupColumn("Frame", 0, 260, 0)
    ImGui.TableSetupColumn("Mod", 0, 150, 0)
    ImGui.TableSetupColumn("%", 0, 140, 0)
    ImGui.TableSetupColumn("Value", 0, 90, 0)
    ImGui.TableNextRow()
    render_sort_header("Frame", SORT_NAME)
    render_sort_header("Mod", SORT_NAME)
    render_sort_header("%", SORT_VALUE)
    render_sort_header("Value", SORT_VALUE)
    for i = 1, #entries do render_view_row(cap, view, entries[i]) end
    ImGui.EndTable()
end

local function render_table(cap)
    local view = VIEWS[view_index]
    if view.key == VIEW_BY_MOD then render_bymod_table(cap) else render_view_table(cap, view) end
end

local function render_ranked(title, list, total)
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_DIM)
    ImGui.Text(title)
    ImGui.PopStyleColor(1)
    if #list == 0 then ImGui.Text("  (none)"); return end
    local shown = math.min(#list, TOP_NEIGHBORS)
    for i = 1, shown do
        local pct = total > 0 and 100 * list[i][2] / total or 0
        ImGui.Text(format("  %5.1f%%  %s", pct, list[i][1]))
    end
end

-- The stack neighbors of the selected frame: callers stand toward the root, callees toward the leaf.
local function render_neighbors(cap)
    if not (selected_frame and selected_neighbors) then return end
    ImGui.Separator()
    ImGui.Text("SELECTED  " .. selected_frame)
    render_ranked("CALLERS (toward root)", selected_neighbors.callers, cap.total)
    render_ranked("CALLEES (toward leaf)", selected_neighbors.callees, cap.total)
end

local function render_vmstate_bar(state, weight, total)
    if weight <= 0 then return end
    local frac = weight / total
    ImGui.PushStyleColor(ImGuiCol.Text, state.color)
    ImGui.Text(format("%-12s", state.label))
    ImGui.PopStyleColor(1)
    ImGui.SameLine(120)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, state.color)
    ImGui.ProgressBar(frac, VMBAR_SIZE, "")
    ImGui.PopStyleColor(1)
    if ImGui.IsItemHovered() then ImGui.SetTooltip(state.tip) end
    ImGui.SameLine()
    ImGui.Text(format("%.1f%%", frac * 100))
end

local function render_vmstate(cap)
    local vm = cap.meta.vmstate
    local total = cap.total
    if not vm or total <= 0 then return end
    for i = 1, #VMSTATE do
        render_vmstate_bar(VMSTATE[i], vm[VMSTATE[i].code] or 0, total)
    end
end

-- Live LuaJIT GC health from jit.util.gcstat: a bar for the heap toward the next collection, then the live estimate and debt.
local function render_gc_health()
    if not gcstat_fn then return end
    local stat = gcstat_fn()
    local mb = 1 / BYTES_PER_MB
    local frac = stat.threshold > 0 and stat.total / stat.threshold or 0
    if frac > 1 then frac = 1 end
    ImGui.Text(format("%-10s", "GC heap"))
    ImGui.SameLine(120)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, get_heat_color(frac * 100))
    ImGui.ProgressBar(frac, VMBAR_SIZE, "")
    ImGui.PopStyleColor(1)
    ImGui.SameLine()
    ImGui.Text(format("%.1f / %.1f MB to next GC", stat.total * mb, stat.threshold * mb))
    ImGui.Text(format("live estimate %.1f MB   debt %.0f B", stat.estimate * mb, stat.debt))
end

-- On MT the CPU G% is inflated while parallel GC runs; this toggle flips lua_parallel_gc for a clean read. Hidden when the cvar is absent (single-thread exe).
local has_pgc
local function render_pgc_toggle()
    if has_pgc == nil then has_pgc = get_console():get_string("lua_parallel_gc") ~= nil end
    if not has_pgc then return end
    local on = get_console():get_integer("lua_parallel_gc") ~= 0
    local _, new_on = ImGui.Checkbox("Parallel GC", on)
    if new_on ~= on then get_console():execute("lua_parallel_gc " .. (new_on and "1" or "0")) end
    if ImGui.IsItemHovered() then ImGui.SetTooltip("Off gives a clean CPU G%; the MT parallel GC inflates it.") end
end

local function render_controls()
    render_capture_button(KIND_CPU)
    ImGui.SameLine()
    render_capture_button(KIND_MEM)
    if JitProfiler.is_mem_active() then
        ImGui.SameLine()
        if ImGui.Button("Snapshot##snap", BTN_SIZE) then JitProfiler.write_snapshot() end
    end
    ImGui.SameLine(0, 20)
    ImGui.Text("Filter")
    ImGui.SameLine()
    ImGui.SetNextItemWidth(FILTER_W)
    local new_filter = ImGui.InputText("##filter", filter_text, 64)
    if new_filter then filter_text = new_filter end
    ImGui.SameLine(0, 20)
    fold_baseline = JitProfiler.get_setting("fold")
    local _, new_fold = ImGui.Checkbox("Fold baseline", fold_baseline)
    if new_fold ~= fold_baseline then JitProfiler.set_setting("fold", new_fold) end
    fold_baseline = new_fold
    ImGui.SameLine(0, 20)
    render_pgc_toggle()
end

-- One integer capture setting as a whole-number slider, written back to the session state on change.
local function render_int_setting(key, label, min, max)
    local changed, value = ImGui.SliderFloat(label, JitProfiler.get_setting(key), min, max, "%.0f")
    if changed then JitProfiler.set_setting(key, floor(value + 0.5)) end
end

local function render_settings()
    if not ImGui.CollapsingHeader("Settings") then return end
    render_int_setting("interval", "CPU interval (ms)", 1, 20)
    render_int_setting("depth", "Stack depth", 4, 64)
    render_int_setting("top_n", "Report rows", 10, 100)
    render_int_setting("auto_snap", "Auto-snapshot at (%)", 50, 99)
    render_int_setting("duration", "Auto-stop after (s)", 0, 600)
end

local function render_tab(cap)
    if cap.kind == KIND_CPU then
        ImGui.Text(format("%d samples   ~%.0fs   %s", cap.meta.samples or 0, cap.meta.duration or 0, cap.meta.stamp or "?"))
    else
        ImGui.Text(format("%s allocated   ~%.0fs   %s", format_weight(KIND_MEM, cap.total), cap.meta.duration or 0, cap.meta.stamp or "?"))
    end
    local at_cap = (cap.total > 0) and 100 * (cap.meta.clipped or 0) / cap.total or 0
    ImGui.Text(format("stack depth %d / cap %d   %.1f%% at cap",
        cap.meta.max_depth or 0, cap.meta.depth or 0, at_cap))
    if cap.kind == KIND_CPU then
        ImGui.Separator()
        render_vmstate(cap)
    end
    ImGui.Separator()
    render_table(cap)
    render_neighbors(cap)
end

-- Add one _G entry to the browser groups when it is a script module (a table with any function member), under its owner.
local function add_script(name, value, groups)
    if type(name) ~= "string" or type(value) ~= "table" then return end
    local is_script = false
    for _, member in pairs(value) do if type(member) == "function" then is_script = true; break end end
    if is_script then
        local owner = JitProfiler.get_owner(name .. ".script")
        local bucket = groups[owner] or {}
        groups[owner] = bucket
        bucket[#bucket + 1] = name
    end
end

-- Build the browser tree once: every loaded script module grouped by owning mod, sorted. Rebuilt on demand.
local function build_tree()
    local groups = {}
    for name, value in pairs(_G) do add_script(name, value, groups) end
    local list = {}
    for owner, scripts in pairs(groups) do
        table.sort(scripts)
        list[#list + 1] = { owner = owner, scripts = scripts }
    end
    table.sort(list, function(left, right) return left.owner < right.owner end)
    tree_cache = list
end

-- One tree row: a +/- button that adds or removes the script, the same affordance as the sampling by-script rows.
local function render_tree_item(name)
    local on = JitProfiler.is_target(name)
    if ImGui.Button((on and "-##t" or "+##t") .. name, VZERO) then
        if on then JitProfiler.remove_target(name) else JitProfiler.add_target(name) end
    end
    ImGui.SameLine()
    ImGui.Text(name)
end

-- Substring match of a script name against the search needle; an empty needle matches all.
local function check_match(name, needle)
    return needle == "" or name:lower():find(needle, 1, true) ~= nil
end

-- One mod group: a collapsing header over its scripts, each filtered by the search needle.
local function render_tree_group(group, needle)
    if not ImGui.CollapsingHeader(group.owner .. "##g") then return end
    for j = 1, #group.scripts do
        local name = group.scripts[j]
        if check_match(name, needle) then render_tree_item(name) end
    end
end

-- The BROWSE modlist: scripts grouped by mod with a search box; a + adds each to the set, the same affordance as the sampling rows.
local function render_tree()
    if not tree_cache then build_tree() end
    local new_search = ImGui.InputText("Search##tree", tree_search, 64)
    if new_search then tree_search = new_search end
    ImGui.SameLine()
    if ImGui.Button("Refresh##tree") then build_tree() end
    local needle = tree_search:lower()
    for i = 1, #tree_cache do render_tree_group(tree_cache[i], needle) end
end

-- One scan row: the function, its owner colour, an Own-share bar, and the own/total ms and call count. Skipped when the filter excludes it.
local function render_scan_row(cap, row)
    local owner = JitProfiler.get_owner(row.key)
    if not check_filter(row.key, owner) then return end
    local own_pct = (cap.total_us or 0) > 0 and 100 * row.self_us / cap.total_us or 0
    ImGui.TableNextRow()
    ImGui.TableNextColumn()
    ImGui.PushStyleColor(ImGuiCol.Text, get_mod_color(owner))
    ImGui.Text(row.key)
    ImGui.PopStyleColor(1)
    if ImGui.IsItemHovered() then
        ImGui.SetTooltip(format("%s\navg %.1f us   min %.1f us   max %.1f us",
            owner, row.calls > 0 and row.self_us / row.calls or 0, row.min_us or 0, row.max_us or 0))
    end
    ImGui.TableNextColumn()
    render_bar(own_pct)
    render_num(format("%8.2f", row.self_us / 1000))
    render_num(format("%8.2f", row.total_us / 1000))
    render_num(format("%8d", row.calls))
end

-- Sort the instrument rows in place by the chosen field; key sorts by name, the rest by value.
local function sort_scan_rows(rows)
    local field, asc = scan_sort, scan_sort_asc
    table.sort(rows, function(left, right)
        if asc then return left[field] < right[field] end
        return left[field] > right[field]
    end)
end

-- A clickable results header; a click sets the sort field, a second click on the same field flips direction.
local function render_scan_header(label, field)
    ImGui.TableNextColumn()
    if ImGui.Button(label .. "##sh") then
        if scan_sort == field then scan_sort_asc = not scan_sort_asc else scan_sort, scan_sort_asc = field, false end
    end
end

-- The scan results: each wrapped function with an own-share bar, sortable by any column header.
local function render_scan_table(cap)
    sort_scan_rows(cap.rows or {})
    if not ImGui.BeginTable("jf_scan", 5, TABLE_FLAGS, TABLE_SIZE, 0) then return end
    ImGui.TableSetupColumn("Function", 0, 240, 0)
    ImGui.TableSetupColumn("Own %", 0, 130, 0)
    ImGui.TableSetupColumn("Own ms", 0, 70, 0)
    ImGui.TableSetupColumn("Total ms", 0, 70, 0)
    ImGui.TableSetupColumn("Calls", 0, 60, 0)
    ImGui.TableNextRow()
    render_scan_header("Function", "key")
    render_scan_header("Own %", "self_us")
    render_scan_header("Own ms", "self_us")
    render_scan_header("Total ms", "total_us")
    render_scan_header("Calls", "calls")
    local rows = cap.rows or {}
    for i = 1, #rows do render_scan_row(cap, rows[i]) end
    ImGui.EndTable()
end

local function render_scan_tab(cap)
    ImGui.Text(format("%d scripts, %d functions   %d frames   %s",
        cap.meta.targets or 0, cap.meta.wrapped or 0, cap.meta.frames or 0, cap.meta.stamp or "?"))
    if (cap.meta.frames or 0) > 0 then
        local pfm = cap.meta.per_frame_ms or 0
        ImGui.Text(format("%-14s", "frame budget"))
        ImGui.SameLine(160)
        render_bar(math.min(100, pfm / FRAME_MS_60 * 100))
        ImGui.SameLine()
        ImGui.Text(format("%.3f ms own / frame  (16.7 ms at 60fps)", pfm))
    else
        ImGui.Text(format("%.1f ms own total over ~%.0fs   (menu capture, no actor frames)", (cap.total_us or 0) / 1000, cap.meta.duration or 0))
    end
    ImGui.Separator()
    render_scan_table(cap)
end

-- The MCM toggle for the ImGui overlay; defaults to shown until the config loads. Cached table read, no per-frame ini parse.
local function is_overlay_enabled()
    local cfg = jf_mcm and jf_mcm.cfg
    return not cfg or cfg.show_imgui ~= false
end

-- One top-mode tab button (SAMPLING or INSTRUMENTATION).
local function render_mode_tab(mode, label)
    local sel = (active_mode == mode)
    ImGui.PushStyleColor(ImGuiCol.Button, sel and COLOR_ACCENT or COLOR_DIM)
    if ImGui.Button(label .. "##mode", VZERO) and active_mode ~= mode then
        active_mode = mode
        selected_frame, selected_neighbors = nil, nil
    end
    ImGui.PopStyleColor(1)
end

-- The SAMPLING body: the retained CPU or MEM capture, under the axis tabs and controls drawn above it.
local function render_sampling_body()
    if active_tab == KIND_MEM then
        render_gc_health()
        ImGui.Separator()
    end
    local cap = JitProfiler.get_last_capture(active_tab)
    if cap then
        render_tab(cap)
    else
        ImGui.Text("No capture yet.  Start " .. ((active_tab == KIND_CPU) and "CPU" or "MEM") .. ", play, then Stop.")
    end
end

-- The current instrumentation set: each target with a remove button, so the picked scripts are visible without hunting the tree.
local function render_selected()
    local targets = JitProfiler.get_targets()
    ImGui.Text(format("SELECTED  %d", #targets))
    if #targets == 0 then
        ImGui.Text("  none.  use the BROWSE tab, or + on a SAMPLING by-script row")
        return
    end
    for i = 1, #targets do
        local name = targets[i]
        if ImGui.Button("x##sel" .. name, VZERO) then JitProfiler.remove_target(name) end
        ImGui.SameLine()
        ImGui.Text(name)
    end
end

-- One instrumentation sub-view tab (SELECTED or BROWSE).
local function render_inst_view_tab(view, label)
    local sel = (inst_view == view)
    ImGui.PushStyleColor(ImGuiCol.Button, sel and COLOR_ACCENT or COLOR_DIM)
    if ImGui.Button(label .. "##iv", VZERO) then inst_view = view end
    ImGui.PopStyleColor(1)
end

-- The INSTRUMENTATION body: the run control and overhead guard, then either the SELECTED working list plus results, or the BROWSE modlist.
local function render_instrument()
    local targets, wrapped = JitProfiler.get_target_stats()
    local active = JitProfiler.is_scan_active()
    if active then
        if ImGui.Button("Stop##inst", BTN_SIZE) then JitProfiler.stop_scan() end
    elseif JitProfiler.is_cpu_active() or JitProfiler.is_mem_active() then
        ImGui.PushStyleColor(ImGuiCol.Button, COLOR_DIM)
        ImGui.Button("Start##inst", BTN_SIZE)
        ImGui.PopStyleColor(1)
    else
        if ImGui.Button("Start##inst", BTN_SIZE) then JitProfiler.start_scan() end
    end
    ImGui.SameLine()
    ImGui.Text(format("%d scripts, %d functions", targets, wrapped))
    if wrapped > OVERHEAD_WARN then
        ImGui.SameLine()
        ImGui.PushStyleColor(ImGuiCol.Text, VMSTATE[4].color)
        ImGui.Text("large set, expect frame cost")
        ImGui.PopStyleColor(1)
    end
    ImGui.Separator()
    render_inst_view_tab(INST_SELECTED, "SELECTED")
    ImGui.SameLine()
    render_inst_view_tab(INST_BROWSE, "BROWSE")
    ImGui.Separator()
    if inst_view == INST_BROWSE then
        render_tree()
        return
    end
    render_selected()
    local cap = JitProfiler.get_last_capture(KIND_SCAN)
    if cap and not active then ImGui.Separator(); render_scan_tab(cap) end
end

-- The CPU/MEM axis selector for SAMPLING, drawn above the controls so the axis precedes the view.
local function render_axis_tabs()
    render_tab_button(KIND_CPU, "CPU")
    ImGui.SameLine()
    render_tab_button(KIND_MEM, "MEM")
end

-- The location line under the mode row: which mode, axis, and view (or instrumentation sub-view) is active.
local function render_crumb()
    local path
    if active_mode == MODE_SAMPLING then
        path = "SAMPLING > " .. ((active_tab == KIND_CPU) and "CPU" or "MEM") .. " > " .. VIEWS[view_index].label
    else
        path = "INSTRUMENTATION > " .. ((inst_view == INST_SELECTED) and "SELECTED" or "BROWSE")
    end
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_ACCENT)
    ImGui.Text(path)
    ImGui.PopStyleColor(1)
end

local function render_panel()
    if not (panel_open and is_overlay_enabled()) then return end
    ImGui.SetNextWindowSize(WINDOW_SIZE, ImGuiCond.FirstUseEver)
    ImGui.PushStyleColor(ImGuiCol.WindowBg, COLOR_BG)
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    ImGui.PushStyleColor(ImGuiCol.PlotHistogram, COLOR_ACCENT)
    local expanded, open = ImGui.Begin("JitProfiler", panel_open, 0)
    panel_open = open
    if expanded then
        init_mono()
        push_mono()
        render_mode_tab(MODE_SAMPLING, "SAMPLING")
        ImGui.SameLine()
        render_mode_tab(MODE_INSTRUMENT, "INSTRUMENTATION")
        render_crumb()
        ImGui.Separator()
        if active_mode == MODE_SAMPLING then
            render_axis_tabs()
            ImGui.Separator()
            render_controls()
            render_view_combo()
            ImGui.Separator()
            render_sampling_body()
        else
            render_instrument()
        end
        ImGui.Separator()
        render_settings()
        pop_mono()
    end
    ImGui.End()
    ImGui.PopStyleColor(3)
end

local function render_menu()
    if not is_overlay_enabled() then return end
    if not ImGui.BeginMenu("JitProfiler") then return end
    local _
    _, panel_open = ImGui.MenuItem("Panel", nil, panel_open, true)
    ImGui.EndMenu()
end

-- Always-on corner banner via the Unique group; renders every frame, shows only while a capture runs.
local function render_banner()
    if not is_overlay_enabled() then return end
    local cpu_on = JitProfiler.is_cpu_active()
    local scan_on = JitProfiler.is_scan_active()
    if not (cpu_on or JitProfiler.is_mem_active() or scan_on) then return end
    local label = cpu_on and "CPU PROFILER" or (scan_on and "INSTRUMENT" or "MEM PROFILER")
    local prog = JitProfiler.get_capture_progress()
    if prog then
        label = label .. "   " .. format_clock(prog.elapsed)
        if prog.limit > 0 then label = label .. " / " .. format_clock(prog.limit) end
    end
    ImGui.SetNextWindowPos(BANNER_POS, ImGuiCond.Always)
    ImGui.PushStyleColor(ImGuiCol.WindowBg, COLOR_BG)
    ImGui.PushStyleColor(ImGuiCol.Text, COLOR_TEXT)
    local expanded = ImGui.Begin("##jf_banner", true, BANNER_FLAGS)
    if expanded then ImGui.Text(label) end
    ImGui.End()
    ImGui.PopStyleColor(2)
end

-- Register the panel, menu, and banner once the ImGui Groups API is present; the _G flag survives the chunk double-load.
local function try_init()
    if rawget(_G, "__jitprofiler_ui_registered") then return true end
    if not (ImGui and ImGui.Groups and ImGui.Groups.Widget) then return false end
    local widget = ImGui.Groups.Widget
    rawset(_G, "__jitprofiler_ui_registered", true)
    widget("MenuBar", render_menu)
    widget("Main", render_panel)
    widget("Unique", render_banner)
    return true
end

function on_game_start()
    if rawget(_G, "__jitprofiler_ui_started") then return end
    rawset(_G, "__jitprofiler_ui_started", true)
    RegisterScriptCallback("actor_on_update", try_init)
end
