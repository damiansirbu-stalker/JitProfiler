--- jitprofiler_report: JitProfiler's presentation layer -- text reports, SpeedScope .folded flamegraphs, and call-graph neighbors over the computed views.

local string, table, math, pairs, ipairs = string, table, math, pairs, ipairs
local tostring, os, format = tostring, os, string.format
local type, next, rawget, debug = type, next, rawget, debug
local mfloor, mceil = math.floor, math.ceil
local KIND_CPU, KIND_MEM, KIND_SCAN, KIND_CALLBACKS, KIND_FRAME = "cpu", "mem", "scan", "callbacks", "frame"

-- FRAME chart series is max-preserving downsampled to this many columns, so a spike survives the reduction.
local FRAME_CHART_COLUMNS = 600
-- Report a rhythm only with at least this many hitches, so a handful never names a fake period.
local FRAME_MIN_HITCHES_FOR_RHYTHM = 5
-- The 0.1% low needs a long capture to mean anything; below this frame count, show the 1% low alone.
local FRAME_MIN_FRAMES_FOR_P999 = 2000
-- Distribution band edges in ms: the frame-rate each caps (60, 30, 20, 10 fps).
local MS_60FPS, MS_30FPS, MS_20FPS, MS_10FPS = 16, 33, 50, 100

local RULE = "================================================================================"
local BAR_WIDTH    = 20
local BYTES_PER_MB = 1048576
local BYTES_PER_KB = 1024
local OWNER_MOD    = "mod: "
local OWNER_LOOSE  = "loose: "
-- A mod function under at least this share of all stacks hooks the callback system; it keeps Own, takes no Caused, and is tagged.
WRAPPER_SHARE = 80
-- The COST section header, shared by the .txt and the panel (jitprofiler_ui reads it).
COST_TITLE = "COST   every sample on one row: Own is time in the code itself, Caused is vanilla or engine work a mod made run"
-- Vanilla functions that call into mod-provided code, by name; a mod frame one of these called was called to do a job and owns what it caused.
--- @novalidate(xray.cached_timer_global, reason:"a frame-name key in a lookup set; the live function is never cached")
local DISPATCH_NAMES = { make_callback = true, SendScriptCallback = true, callback = true, callback_set = true, callback_unset = true, ProcessEventQueue = true }

-- Per-sample VM state label for the CPU report header.
local VMSTATE = {
    N = "JIT-compiled (native)", I = "interpreter", C = "C / engine call",
    G = "garbage collector", J = "JIT compiler",
}
local VMORDER = { "N", "I", "C", "G", "J" }
-- The same dispatchers as { module or false, name }, resolved to live functions at report time, so an overlay or a call-site alias still matches.
local DISPATCH_SOURCES = {
    { false, "ProcessEventQueue" }, { false, "SendScriptCallback" }, { "axr_main", "make_callback" },
    { "xr_logic", "pick_section_from_condlist" }, { "xr_logic", "issue_event" },
    { "xr_logic", "try_switch_to_another_section" }, { "xr_logic", "switch_to_section" },
}
-- The dispatcher definition sites, resolved once per Lua state on first use.
local dispatch_sites

-- xlog resolves lazily; the "JitProfiler" logger is shared with the front-end (get_logger returns the cached facade).
local log_handle
local function log(fmt, ...)
    if not log_handle then log_handle = xlog.get_logger("JitProfiler", { outfile = "jitprofiler.log", level = "INFO" }) end
    log_handle.info(fmt, ...)
end

-- Effective fold for the report in flight; each write_* entry point sets it, build_view reads it.
local report_fold = false

local function get_timestamp()
    return os.date("%Y%m%d_%H%M%S")
end

local function build_log_path(name)
    local base = xfs.resolve_path("$logs$", "")
    return (base or "") .. name
end

local function write_lines(path, lines)
    if not xfs.write_file(path, table.concat(lines, "\n") .. "\n") then
        log("!JitProfiler: cannot write %s", tostring(path)); return nil
    end
    return path
end

local function format_bytes(value)
    if value >= BYTES_PER_MB then return format("%.1f MB", value / BYTES_PER_MB) end
    if value >= BYTES_PER_KB then return format("%.1f KB", value / BYTES_PER_KB) end
    return format("%.0f B", value)
end
local function format_count(value) return format("%d", value) end

-- ASCII percentage bar that renders in any editor and encoding.
local function build_bar(percent)
    local fill = math.floor((percent / 100) * BAR_WIDTH + 0.5)
    if fill > BAR_WIDTH then fill = BAR_WIDTH elseif fill < 0 then fill = 0 end
    return "[" .. string.rep("#", fill) .. string.rep(" ", BAR_WIDTH - fill) .. "]"
end

-- Reverse a leaf-first stack into the root-first order SpeedScope .folded expects.
local function build_folded_stack(stack)
    local parts, count = {}, 0
    for frame in string.gmatch(stack, "[^;]+") do count = count + 1; parts[count] = JitProfiler.compute_masked_name(JitProfiler.get_short_frame(frame)) end
    local out = {}
    for i = count, 1, -1 do out[#out + 1] = parts[i] end
    return table.concat(out, ";")
end

local function sort_entries(map)
    local entries = {}
    for key, weight in pairs(map) do entries[#entries + 1] = { key, weight } end
    table.sort(entries, function(left, right) return left[2] > right[2] end)
    return entries
end

local function compute_pct(value, total) return total > 0 and (100.0 * value / total) or 0 end

local function get_key_count(map)
    local count = 0
    for _ in pairs(map) do count = count + 1 end
    return count
end

-- Minimal JSON encoder over the known capture value set (string / number / boolean / array / object); no library ships with Anomaly.
local JSON_ESCAPE = { ['"'] = '\\"', ['\\'] = '\\\\', ["\n"] = '\\n', ["\r"] = '\\r', ["\t"] = '\\t' }
local function format_json(value)
    local kind = type(value)
    if kind == "string" then
        return '"' .. value:gsub('[%z\1-\31\\"]', function(char) return JSON_ESCAPE[char] or format("\\u%04x", char:byte()) end) .. '"'
    end
    if kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then return "null" end
        return format("%.14g", value)
    end
    if kind == "boolean" then return value and "true" or "false" end
    if kind ~= "table" then return "null" end
    local count = #value
    if count > 0 or next(value) == nil then
        local parts = {}
        for i = 1, count do parts[i] = format_json(value[i]) end
        return "[" .. table.concat(parts, ",") .. "]"
    end
    local parts = {}
    for key, val in pairs(value) do parts[#parts + 1] = format_json(tostring(key)) .. ":" .. format_json(val) end
    return "{" .. table.concat(parts, ",") .. "}"
end

-- Rank a dual (own + total) view into masked, total-sorted rows for the json export.
local function build_dual_rows(own_map, total_map, with_owner)
    local rows = {}
    for name, total in pairs(total_map) do
        local row = { name = JitProfiler.compute_masked_name(name), own = own_map[name] or 0, total = total }
        if with_owner then row.owner = JitProfiler.compute_masked_name(JitProfiler.get_owner(name)) end
        rows[#rows + 1] = row
    end
    table.sort(rows, function(left, right) return left.total > right.total end)
    return rows
end

-- Rank a single-weight view (leaf / root) into masked, value-sorted rows.
local function build_frame_rows(map, with_owner)
    local rows = {}
    for name, value in pairs(map) do
        local row = { name = JitProfiler.compute_masked_name(name), value = value }
        if with_owner then row.owner = JitProfiler.compute_masked_name(JitProfiler.get_owner(name)) end
        rows[#rows + 1] = row
    end
    table.sort(rows, function(left, right) return left.value > right.value end)
    return rows
end

-- Masked { name, weight } pairs from a sorted entry list.
local function build_named_rows(list)
    local rows = {}
    for i = 1, #list do rows[i] = { name = JitProfiler.compute_masked_name(list[i][1]), weight = list[i][2] } end
    return rows
end

-- The masked COST rows for the json and the page, each with the vanilla functions it caused and the patches or hooks it passed through.
local function build_cost_rows_doc(cost_rows)
    local mask, rows = JitProfiler.compute_masked_name, {}
    for i = 1, #cost_rows do
        local row = cost_rows[i]
        rows[i] = { name = mask(row.key), owner = mask(row.owner), own = row.own, caused = row.caused, total = row.total, hook = row.hook,
                    caused_by = build_named_rows(row.caused_by), via = build_named_rows(row.via) }
    end
    return rows
end

-- Masked rows for the pre-sorted engine-C entry list of a CPU capture.
local function build_engine_rows(list)
    local rows = {}
    for i = 1, #list do
        local frame = list[i][1]
        rows[i] = { name = JitProfiler.compute_masked_name(frame),
                    owner = JitProfiler.compute_masked_name(JitProfiler.get_owner(frame)), value = list[i][2] }
    end
    return rows
end

-- One capture's masked, ranked doc: views/rows plus meta. Names honour the anon setting at build time.
local function build_capture_doc(capture)
    local doc = { kind = capture.kind, stamp = capture.meta.stamp,
                  modded_exes = tostring(_G.MODDED_EXES_VERSION or "?"), meta = capture.meta }
    if capture.kind == KIND_CPU or capture.kind == KIND_MEM then
        local v = capture.views
        doc.total = capture.total
        doc.views = {
            by_mod    = build_dual_rows(v.by_mod, v.by_mod_total, false),
            by_script = build_dual_rows(v.by_script, v.by_script_total, true),
            leaf      = build_frame_rows(v.leaf, true),
            root      = build_frame_rows(v.root, true),
        }
        if capture.engine_entry then doc.engine_entry = build_engine_rows(capture.engine_entry) end
        if capture.cost_rows then doc.cost_rows = build_cost_rows_doc(capture.cost_rows) end
    elseif capture.kind == KIND_SCAN then
        local rows = {}
        for i = 1, #capture.rows do
            local row = capture.rows[i]
            rows[i] = { name = JitProfiler.compute_masked_name(row.key), owner = JitProfiler.compute_masked_name(JitProfiler.get_owner(row.key)),
                        calls = row.calls, self_us = row.self_us, total_us = row.total_us,
                        min_us = row.min_us, max_us = row.max_us, avg_us = row.avg_us }
        end
        table.sort(rows, function(left, right) return left.self_us > right.self_us end)
        doc.total_us = capture.total_us
        doc.rows = rows
    elseif capture.kind == KIND_CALLBACKS then
        local rows = {}
        for i = 1, #capture.rows do
            local rec = capture.rows[i]
            rows[i] = { callback = rec.callback, handler = JitProfiler.compute_masked_name(rec.handler),
                        owner = JitProfiler.compute_masked_name(JitProfiler.get_owner(rec.handler)),
                        calls = rec.calls, self_us = rec.self_us, total_us = rec.total_us,
                        min_us = rec.min_us, max_us = rec.max_us, avg_us = rec.avg_us }
        end
        table.sort(rows, function(left, right) return left.self_us > right.self_us end)
        doc.total_us = capture.total_us
        doc.rows = rows
    elseif capture.kind == KIND_FRAME then
        doc.series = capture.series
        doc.metrics = capture.metrics
        doc.rhythm = capture.rhythm
        local hitches = {}
        for i = 1, #capture.hitches do
            local hitch = capture.hitches[i]
            hitches[i] = { index = hitch.index, dt = hitch.dt, wall = hitch.wall, at_s = hitch.at_s }
        end
        doc.hitches = hitches
        if capture.hitch_views then
            doc.hitch_total = capture.hitch_total
            doc.hitch_leaf = build_frame_rows(capture.hitch_views.leaf, true)
        end
        if capture.cost_rows then doc.cost_rows = build_cost_rows_doc(capture.cost_rows) end
    end
    return doc
end

local function write_folded(kind, by_stack)
    local folded = {}
    for stack, weight in pairs(by_stack) do folded[#folded + 1] = build_folded_stack(stack) .. " " .. format("%.0f", weight) end
    return write_lines(build_log_path("jitprofiler_" .. kind .. ".folded"), folded)
end

-- Append a ranked view with every row (the report is the analysis artifact, never truncated); opts.owned resolves each row's mod and honours report_fold.
local function build_view(lines, title, map, total, fmt, opts)
    local owned = opts and opts.owned
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- " .. title .. " " .. string.rep("-", math.max(2, 68 - #title))
    local entries = sort_entries(map)
    local skipped = 0
    for i = 1, #entries do
        local key, weight = entries[i][1], entries[i][2]
        local owner = owned and JitProfiler.get_owner(key) or nil
        if owned and report_fold and owner and owner:sub(1, #OWNER_MOD) ~= OWNER_MOD then
            skipped = skipped + 1
        else
            local percent = compute_pct(weight, total)
            local display_key = JitProfiler.compute_masked_name(key)
            local label = owner and format("%-30s [%s] %s", JitProfiler.get_masked_label(key), JitProfiler.get_owner_method(key), display_key) or display_key
            lines[#lines + 1] = format("  %6.2f%% %s %12s  %s", percent, build_bar(percent), fmt(weight), label)
        end
    end
    if skipped > 0 then lines[#lines + 1] = format("  (%d baseline rows folded)", skipped) end
end

-- One stack's contribution to a frame's neighbors: callers stand toward root (i+1), callees toward leaf (i-1).
local function collect_neighbors(entry, frame, out)
    local frames, count = {}, 0
    for raw in string.gmatch(entry.stack, "[^;]+") do count = count + 1; frames[count] = JitProfiler.get_short_frame(raw) end
    for i = 1, count do
        local matched = frames[i] == frame
        local up = matched and frames[i + 1]
        local down = matched and frames[i - 1]
        if up then out.callers[up] = (out.callers[up] or 0) + entry.weight end
        if down then out.callees[down] = (out.callees[down] or 0) + entry.weight end
    end
end

-- Callers (who called it) and callees (what it called) of a function from the recorded call-graph edges, each ranked by time.
--- @novalidate(conventions.pairs_on_sequence, reason:"edges and edges[key] are parent-key/child-key maps, not sequences")
local function collect_edge_neighbors(edges, key)
    local callers, callees = {}, {}
    local out = edges[key]
    if out then for ckey, edge in pairs(out) do callees[#callees + 1] = { ckey, edge.us, edge.calls } end end
    for pkey, bucket in pairs(edges) do
        local edge = bucket[key]
        if edge then callers[#callers + 1] = { pkey, edge.us, edge.calls } end
    end
    table.sort(callers, function(left, right) return left[2] > right[2] end)
    table.sort(callees, function(left, right) return left[2] > right[2] end)
    return callers, callees
end

-- A mod-owned owner: an MO2 mod or a loose install folder; anomaly, modded exes, engine, loadstring and unknown are the baseline.
local function is_mod_owner(owner)
    return owner:sub(1, #OWNER_MOD) == OWNER_MOD or owner:sub(1, #OWNER_LOOSE) == OWNER_LOOSE
end

-- The file:line of a short frame, the part a call-site alias cannot change.
local function get_site(short)
    return short:match("@(.+)$") or short
end

-- The dispatcher definition sites, read once from the live functions so an overlay or a renamed call site still matches.
local function get_dispatch_sites()
    if dispatch_sites then return dispatch_sites end
    dispatch_sites = {}
    for i = 1, #DISPATCH_SOURCES do
        local holder, name = DISPATCH_SOURCES[i][1], DISPATCH_SOURCES[i][2]
        local owner_table = holder and rawget(_G, holder) or _G
        local fn = type(owner_table) == "table" and rawget(owner_table, name) or nil
        local info = type(fn) == "function" and debug.getinfo(fn, "S") or nil
        if info and info.short_src then
            dispatch_sites[get_site(JitProfiler.get_short_frame("x@" .. info.short_src .. ":" .. tostring(info.linedefined)))] = true
        end
    end
    return dispatch_sites
end

local function is_dispatcher(short)
    return DISPATCH_NAMES[short:match("^([%w_]+)@") or ""] == true or get_dispatch_sites()[get_site(short)] == true
end

-- The raw frames of a leaf-first stack as an array.
local function split_frames(stack)
    local frames = {}
    for frame in string.gmatch(stack, "[^;]+") do frames[#frames + 1] = frame end
    return frames
end

-- The caller a frame answers to: the next frame toward the root that is neither a C frame nor a hook; nil at the root.
--- @novalidate(code.find_in_loop, reason:"a pattern test on each frame string for the [C] marker, not an equality lookup")
local function find_caller(frames, index, is_hook)
    for j = index + 1, #frames do
        local frame = frames[j]
        if not frame:find("%[C%]") and not is_hook(JitProfiler.get_short_frame(frame)) then return frame end
    end
    return nil
end

-- Whether a mod frame was called to do a job: by the engine (no caller), by mod code, or by a vanilla dispatcher. Anything else is a patch.
local function check_entry(frames, index, is_hook)
    local caller = find_caller(frames, index, is_hook)
    if not caller then return true end
    if is_mod_owner(JitProfiler.get_owner(caller)) then return true end
    return is_dispatcher(JitProfiler.get_short_frame(caller))
end

-- The first mod entry toward the root past the Self frame, or nil; the mod frames passed over (patches and hooks) collect in passes.
local function find_entry(frames, start, is_hook, passes)
    for i = start + 1, #frames do
        local short = JitProfiler.get_short_frame(frames[i])
        local mod = is_mod_owner(JitProfiler.get_owner(frames[i]))
        if mod and not is_hook(short) and check_entry(frames, i, is_hook) then return short end
        if mod then passes[#passes + 1] = short end
    end
    return nil
end

-- Collect one stack: Own to a mod Self frame; else Caused to the first mod entry toward the root; else Own to the vanilla or engine Self frame.
local function collect_stack_cost(stack, weight, get_row, is_hook)
    local frames = split_frames(stack)
    local anchor = JitProfiler.get_stack_anchor(stack)
    local anchor_short = JitProfiler.get_short_frame(anchor)
    if is_mod_owner(JitProfiler.get_owner(anchor)) then
        local row = get_row(anchor_short)
        row.own = row.own + weight
        return
    end
    local start = 1
    for i = 1, #frames do
        if frames[i] == anchor then start = i; break end
    end
    local passes = {}
    local entry = find_entry(frames, start, is_hook, passes)
    if entry then
        local row = get_row(entry)
        row.caused = row.caused + weight
        row.caused_by[anchor_short] = (row.caused_by[anchor_short] or 0) + weight
        return
    end
    local row = get_row(anchor_short)
    row.own = row.own + weight
    for i = 1, #passes do row.via[passes[i]] = (row.via[passes[i]] or 0) + weight end
end

-- One COST line: total, function, owner, own, caused (a dash on a vanilla or engine row), and the hook tag.
local function format_cost_row(row, total)
    local tag, caused = "", "     -"
    if row.hook then tag = "   (hooks the callback system)" end
    if is_mod_owner(row.owner) then caused = format("%5.1f%%", compute_pct(row.caused, total)) end
    return format("%5.1f%%  %-52s %-22s own %5.1f%%  caused %s%s", compute_pct(row.total, total), JitProfiler.compute_masked_name(row.key),
        JitProfiler.compute_masked_name(row.owner), compute_pct(row.own, total), caused, tag)
end

-- The .txt COST section: every row, each followed by the vanilla functions it caused and the patches or hooks it passed through.
local function build_cost_view(lines, rows, total)
    local mask = JitProfiler.compute_masked_name
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- " .. COST_TITLE .. " " .. string.rep("-", 6)
    for i = 1, #rows do
        local row = rows[i]
        lines[#lines + 1] = "  " .. format_cost_row(row, total)
        for j = 1, math.min(#row.caused_by, 3) do lines[#lines + 1] = format("      caused %5.1f%%  %s", compute_pct(row.caused_by[j][2], total), mask(row.caused_by[j][1])) end
        for j = 1, math.min(#row.via, 2) do lines[#lines + 1] = format("      via    %5.1f%%  %s", compute_pct(row.via[j][2], total), mask(row.via[j][1])) end
    end
end


-- The .txt call-graph for a sampling capture: the top leaves, each with its callers (toward root) and callees (toward leaf) from the retained stacks.
local function build_call_graph(lines, by_stack, v, total)
    local leaves = sort_entries(v.leaf)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- CALL GRAPH   top leaves: <- callers (toward root), -> callees (toward leaf) " .. string.rep("-", 6)
    for i = 1, math.min(#leaves, 10) do
        local frame = leaves[i][1]
        local out = { callers = {}, callees = {} }
        for stack, weight in pairs(by_stack) do collect_neighbors({ stack = stack, weight = weight }, frame, out) end
        lines[#lines + 1] = format("  %-58s %5.1f%%", JitProfiler.compute_masked_name(frame), compute_pct(leaves[i][2], total))
        local callers, callees = sort_entries(out.callers), sort_entries(out.callees)
        for j = 1, math.min(#callers, 3) do lines[#lines + 1] = format("      <- %5.1f%%  %s", compute_pct(callers[j][2], total), JitProfiler.compute_masked_name(callers[j][1])) end
        for j = 1, math.min(#callees, 3) do lines[#lines + 1] = format("      -> %5.1f%%  %s", compute_pct(callees[j][2], total), JitProfiler.compute_masked_name(callees[j][1])) end
    end
end

-- CPU report from the computed views; writes the ranked .txt plus the SpeedScope .folded and returns the retained capture entry.
-- FRAME helpers: every statistic is computed once over the full series at stop.
local function compute_percentile(sorted, pct)
    local count = #sorted
    if count == 0 then return 0 end
    local idx = mceil(pct / 100 * count)
    if idx < 1 then idx = 1 elseif idx > count then idx = count end
    return sorted[idx]
end

-- Mean of the worst fraction (the largest `frac` of the ascending-sorted values), the "N% low" pacing metric.
local function compute_low_mean(sorted, frac)
    local count = #sorted
    if count == 0 then return 0 end
    local take = mfloor(count * frac)
    if take < 1 then take = 1 end
    local sum = 0
    for i = count - take + 1, count do sum = sum + sorted[i] end
    return sum / take
end

-- Max-preserving downsample to at most `columns` buckets, so a spike never averages away before the chart.
local function compute_downsample(series, columns)
    local count = #series
    if count <= columns then
        local out = {}
        for i = 1, count do out[i] = series[i] end
        return out
    end
    local out, step = {}, count / columns
    for col = 1, columns do
        local first = mfloor((col - 1) * step) + 1
        local last = mfloor(col * step)
        if last < first then last = first end
        local peak = 0
        for i = first, last do if series[i] > peak then peak = series[i] end end
        out[col] = peak
    end
    return out
end

-- Frame-time distribution: count frames into the fps bands.
local function compute_frame_dist(series)
    local dist = { b16 = 0, b33 = 0, b50 = 0, b100 = 0, bover = 0 }
    for i = 1, #series do
        local dt = series[i]
        if dt <= MS_60FPS then dist.b16 = dist.b16 + 1
        elseif dt <= MS_30FPS then dist.b33 = dist.b33 + 1
        elseif dt <= MS_20FPS then dist.b50 = dist.b50 + 1
        elseif dt <= MS_10FPS then dist.b100 = dist.b100 + 1
        else dist.bover = dist.bover + 1 end
    end
    return dist
end

-- Classify hitches over the full series: a frame clearing both the relative gate and the absolute floor, with its wall offset.
local function compute_frame_hitches(series, t0, median, gate_k, floor_ms)
    local hitches, cum = {}, 0
    for i = 1, #series do
        local dt = series[i]
        cum = cum + dt
        if dt > median * gate_k and dt > floor_ms then
            hitches[#hitches + 1] = { index = i, dt = dt, wall = t0 + cum, at_s = cum / 1000 }
        end
    end
    return hitches
end

-- Inter-hitch interval histogram: the seconds between consecutive hitches, top bucket first; empty below the minimum count.
local function compute_frame_rhythm(hitches)
    local rhythm = {}
    if #hitches < FRAME_MIN_HITCHES_FOR_RHYTHM then return rhythm end
    local buckets = {}
    for i = 2, #hitches do
        local gap_s = mfloor((hitches[i].wall - hitches[i - 1].wall) / 1000 + 0.5)
        buckets[gap_s] = (buckets[gap_s] or 0) + 1
    end
    for sec, hits in pairs(buckets) do rhythm[#rhythm + 1] = { sec = sec, count = hits } end
    table.sort(rhythm, function(left, right) return left.count > right.count end)
    return rhythm
end

function write_cpu(cpu, v, opts)
    local total, duration_sec, gc_line = opts.total, opts.duration, opts.gc_line
    report_fold = opts.fold and true or false
    local top_root = sort_entries(v.root)[1]
    local top_leaf = sort_entries(v.leaf)[1]
    local stacks_note = cpu.dropped > 0
        and format("%d stacks (capped; +%s beyond the ceiling not attributed)", cpu.nstacks, format_count(cpu.dropped))
        or  format("%d stacks", cpu.nstacks)
    local lines = {
        RULE,
        "  JitProfiler  -  CPU sampling profile   (engine-native; the JIT stays on)",
        format("  modded_exes %s   |   %d samples @ %d ms   |   ~%.0f s   |   %s",
            tostring(_G.MODDED_EXES_VERSION or "?"), total, cpu.iv, duration_sec, stacks_note),
    }
    if gc_line then lines[#lines + 1] = gc_line end
    lines[#lines + 1] = RULE
    lines[#lines + 1] = ""
    lines[#lines + 1] = "  WHERE THE LUA TIME GOES  (VM state at each sample)"
    for _, state_code in ipairs(VMORDER) do
        local weight = cpu.state[state_code] or 0
        if weight > 0 then
            local percent = compute_pct(weight, total)
            local flag = (state_code == "G" and percent >= 3) and "  <- allocation pressure: run JitProfiler.start_alloc()" or ""
            lines[#lines + 1] = format("    %s  %-20s %s %5.1f%%%s", state_code, VMSTATE[state_code] or state_code, build_bar(percent), percent, flag)
        end
    end
    lines[#lines + 1] = "    (N is a floor: phase-1 sampling under-counts JIT-compiled traces)"
    lines[#lines + 1] = format("  STACK DEPTH   deepest %d, cap %d, %.1f%% of samples reached the cap",
        v.max_depth, cpu.depth, compute_pct(v.clipped, total))
    lines[#lines + 1] = ""
    if top_root then lines[#lines + 1] = format("  TOP DRIVER  %5.1f%%   %s", compute_pct(top_root[2], total), top_root[1]) end
    if top_leaf then lines[#lines + 1] = format("  TOP LEAF    %5.1f%%   %s", compute_pct(top_leaf[2], total), top_leaf[1]) end

    build_view(lines, "ENGINE-C ENTRY POINTS   Lua call sites that drive engine C/GC (the Optick targets)", v.engine_entry, total, format_count, { owned = true })
    lines[#lines + 1] = format("  engine trunk (no Lua caller on the stack)   %5.1f%%", compute_pct(v.engine_trunk, total))

    build_view(lines, "BY MOD   Total (on the stack anywhere; does not sum to 100%)", v.by_mod_total, total, format_count)
    build_view(lines, "BY MOD   Own (innermost frame only)", v.by_mod, total, format_count)
    build_view(lines, "BY SCRIPT   Total (on the stack anywhere)", v.by_script_total, total, format_count, { owned = true })
    build_view(lines, "BY SCRIPT   Own (innermost frame only)", v.by_script, total, format_count, { owned = true })
    build_view(lines, "BY LEAF   the hot function (Own)", v.leaf, total, format_count, { owned = true })
    build_view(lines, "BY ROOT   the outermost frame", v.root, total, format_count, { owned = true })
    build_view(lines, "FRAMEWORK vs HANDLERS   dispatch overhead vs real work", v.framework, total, format_count)
    local cost_rows = compute_cost_rows(cpu.stacks)
    build_cost_view(lines, cost_rows, total)
    build_call_graph(lines, cpu.stacks, v, total)

    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_cpu_" .. stamp .. ".txt"), lines)
    local folded_path = write_folded("cpu_" .. stamp, cpu.stacks)
    log("JitProfiler/cpu: report -> %s | flamegraph -> %s (speedscope.app)", tostring(report_path), tostring(folded_path))
    return {
        kind = KIND_CPU, by_stack = cpu.stacks, views = v, total = total, engine_entry = sort_entries(v.engine_entry), cost_rows = cost_rows,
        meta = { samples = total, interval = cpu.iv, duration = duration_sec, stamp = stamp,
                 vmstate = cpu.state, dropped = cpu.dropped, depth = cpu.depth, max_depth = v.max_depth, clipped = v.clipped },
    }
end

-- Allocation report from the computed views; writes .txt + .folded and returns the retained capture entry (nil for a numbered snapshot).
function write_alloc(v, opts)
    local by_stack, total, duration_sec, suffix = opts.by_stack, opts.total, opts.duration, opts.suffix
    local title, depth, peak, gc_line, diag = opts.title, opts.depth, opts.peak, opts.gc_line, opts.diag
    report_fold = opts.fold and true or false
    if diag.drains == 0 or diag.entries == 0 then
        log("!JitProfiler/alloc: capture problem -- drains=%.0f  seen=%s  pending=%s  entries=%d",
            diag.drains, format_bytes(diag.seen), format_bytes(diag.pending), diag.entries)
    end
    local top_root = sort_entries(v.root)[1]
    local top_leaf = sort_entries(v.leaf)[1]
    local rate_mb = duration_sec > 0 and (total / BYTES_PER_MB / duration_sec) or 0
    local lines = {
        RULE,
        "  JitProfiler  -  " .. title,
        format("  modded_exes %s   |   %s allocated (%.1f MB/s)   |   ~%.0f s   |   %d stacks",
            tostring(_G.MODDED_EXES_VERSION or "?"), format_bytes(total), rate_mb, duration_sec, get_key_count(by_stack)),
    }
    if gc_line then lines[#lines + 1] = gc_line end
    lines[#lines + 1] = format("  ALLOC TABLE   peak %d%% full", peak)
    lines[#lines + 1] = RULE
    lines[#lines + 1] = ""
    lines[#lines + 1] = "  WHO GENERATES THE GARBAGE  (GC pressure is the stutter source)"
    if diag.dropped > 0 then
        lines[#lines + 1] = format(
            "  NOTE  window exceeded table capacity; %s not attributed -- snapshot/stop sooner", format_bytes(diag.dropped))
    end
    if top_leaf then lines[#lines + 1] = format("  TOP ALLOCATOR  %5.1f%%   %s", compute_pct(top_leaf[2], total), top_leaf[1]) end
    if top_root then lines[#lines + 1] = format("  TOP DRIVER     %5.1f%%   %s", compute_pct(top_root[2], total), top_root[1]) end
    lines[#lines + 1] = format("  STACK DEPTH    deepest %d, cap %d, %.1f%% of bytes reached the cap",
        v.max_depth, depth, compute_pct(v.clipped, total))

    build_view(lines, "BY MOD   Total (on the stack anywhere; does not sum to 100%)", v.by_mod_total, total, format_bytes)
    build_view(lines, "BY MOD   Own (innermost frame only)", v.by_mod, total, format_bytes)
    build_view(lines, "BY SCRIPT   Total (on the stack anywhere)", v.by_script_total, total, format_bytes, { owned = true })
    build_view(lines, "BY SCRIPT   Own (innermost frame only)", v.by_script, total, format_bytes, { owned = true })
    build_view(lines, "BY LEAF   who allocates (Own)", v.leaf, total, format_bytes, { owned = true })
    build_view(lines, "BY ROOT   the outermost frame", v.root, total, format_bytes, { owned = true })
    build_view(lines, "FRAMEWORK vs HANDLERS   dispatch overhead vs real work", v.framework, total, format_bytes)
    local cost_rows = compute_cost_rows(by_stack)
    build_cost_view(lines, cost_rows, total)
    build_call_graph(lines, by_stack, v, total)

    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_mem" .. suffix .. "_" .. stamp .. ".txt"), lines)
    local folded_path = write_folded("mem" .. suffix .. "_" .. stamp, by_stack)
    log("JitProfiler/alloc: report -> %s | flamegraph -> %s (speedscope.app)", tostring(report_path), tostring(folded_path))
    if suffix ~= "" then return end
    return {
        kind = KIND_MEM, by_stack = by_stack, views = v, total = total, cost_rows = cost_rows,
        meta = { bytes = total, duration = duration_sec, stamp = stamp, stacks = get_key_count(by_stack),
                 dropped = diag.dropped, depth = depth, max_depth = v.max_depth, clipped = v.clipped },
    }
end

-- Instrumentation report: rank the wrapped functions by own time, per-mod subtotals, and a call graph. Returns the retained capture entry.
function write_scan(records, opts)
    local frames, duration_sec, targets, wrapped, edges = opts.frames, opts.duration, opts.targets, opts.wrapped, opts.edges
    local rows, total_self = {}, 0
    for key, rec in pairs(records) do
        if rec.calls > 0 then
            rows[#rows + 1] = { key = key, calls = rec.calls, self_us = rec.self_us, total_us = rec.total_us,
                                min_us = rec.min_us, max_us = rec.max_us, avg_us = rec.self_us / rec.calls }
            total_self = total_self + rec.self_us
        end
    end
    table.sort(rows, function(left, right) return left.self_us > right.self_us end)
    local ms_self = total_self / 1000.0
    local per_frame_ms = frames > 0 and (ms_self / frames) or 0
    local total_line = frames > 0
        and format("  OWN TOTAL   %.1f ms over %d frames   =   %.3f ms per frame", ms_self, frames, per_frame_ms)
        or  format("  OWN TOTAL   %.1f ms over ~%.0f s   (menu capture, no actor frames)", ms_self, duration_sec)
    local lines = {
        RULE,
        "  JitProfiler  -  INSTRUMENTATION   own + total wall-clock (engine C included)",
        format("  modded_exes %s   |   %d scripts, %d functions   |   ~%.0f s   |   %d frames",
            tostring(_G.MODDED_EXES_VERSION or "?"), targets, wrapped, duration_sec, frames),
        RULE,
        "",
        total_line,
        "",
        format("  %-46s %-22s %8s   %10s   %10s   %8s   %8s   %8s",
            "FUNCTION", "OWNER", "CALLS", "OWN ms", "TOTAL ms", "avg ms", "min ms", "max ms"),
    }
    for i = 1, #rows do
        local row = rows[i]
        lines[#lines + 1] = format("  %-46s %-22s %8d   %10.2f   %10.2f   %8.3f   %8.3f   %8.3f",
            JitProfiler.compute_masked_name(row.key), JitProfiler.compute_masked_name(JitProfiler.get_owner(row.key)),
            row.calls, row.self_us / 1000.0, row.total_us / 1000.0,
            row.avg_us / 1000.0, row.min_us / 1000.0, row.max_us / 1000.0)
    end
    local RULE_DASH = string.rep("-", 60)
    local mod_self, mod_total, mod_count = {}, {}, {}
    for i = 1, #rows do
        local owner = JitProfiler.get_owner(rows[i].key)
        mod_self[owner] = (mod_self[owner] or 0) + rows[i].self_us
        mod_total[owner] = (mod_total[owner] or 0) + rows[i].total_us
        mod_count[owner] = (mod_count[owner] or 0) + 1
    end
    local mod_rows = {}
    for owner in pairs(mod_self) do mod_rows[#mod_rows + 1] = owner end
    table.sort(mod_rows, function(left, right) return mod_self[left] > mod_self[right] end)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- BY MOD   own / total ms across the wrapped functions " .. RULE_DASH
    for i = 1, #mod_rows do
        local owner = mod_rows[i]
        local per_frame = frames > 0 and (mod_self[owner] / 1000.0 / frames) or 0
        lines[#lines + 1] = format("  %-40s %8.2f ms own   %8.2f ms total   %6.3f ms/frame   %3d fns",
            JitProfiler.compute_masked_name(owner), mod_self[owner] / 1000.0, mod_total[owner] / 1000.0, per_frame, mod_count[owner])
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- CALL GRAPH   top functions: <- callers, -> callees (ms, calls) " .. RULE_DASH
    for i = 1, math.min(#rows, 10) do
        local row = rows[i]
        lines[#lines + 1] = format("  %s   own %.2f ms   total %.2f ms",
            JitProfiler.compute_masked_name(row.key), row.self_us / 1000.0, row.total_us / 1000.0)
        local callers, callees = collect_edge_neighbors(edges, row.key)
        for j = 1, math.min(#callers, 3) do
            lines[#lines + 1] = format("      <- %-52s %8.2f ms  (%d)", JitProfiler.compute_masked_name(callers[j][1]), callers[j][2] / 1000.0, callers[j][3])
        end
        for j = 1, math.min(#callees, 3) do
            lines[#lines + 1] = format("      -> %-52s %8.2f ms  (%d)", JitProfiler.compute_masked_name(callees[j][1]), callees[j][2] / 1000.0, callees[j][3])
        end
    end
    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_inst_" .. stamp .. ".txt"), lines)
    log("JitProfiler/inst: report -> %s", tostring(report_path))
    return {
        kind = KIND_SCAN, rows = rows, edges = edges, frames = frames, total_us = total_self,
        meta = { targets = targets, wrapped = wrapped, frames = frames,
                 duration = duration_sec, stamp = stamp, per_frame_ms = per_frame_ms },
    }
end

-- Callbacks report: rank the timed handlers by own ms with a per-callback rollup. Returns the retained capture entry.
function write_callbacks(records, wrapped, duration_sec)
    local rows, total_self = {}, 0
    for _, rec in pairs(records) do
        if rec.calls > 0 then rec.avg_us = rec.self_us / rec.calls; rows[#rows + 1] = rec; total_self = total_self + rec.self_us end
    end
    table.sort(rows, function(left, right) return left.self_us > right.self_us end)
    local lines = {
        RULE,
        "  JitProfiler  -  CALLBACKS   per-handler wall-clock over the make_callback dispatch (engine C included)",
        format("  modded_exes %s   |   %d handlers wrapped   |   ~%.0f s   |   %.1f ms own total",
            tostring(_G.MODDED_EXES_VERSION or "?"), wrapped, duration_sec, total_self / 1000.0),
        RULE,
        "",
        format("  %-34s %-30s %-22s %8s   %10s   %10s   %8s   %8s   %8s",
            "CALLBACK", "HANDLER", "OWNER", "CALLS", "OWN ms", "TOTAL ms", "avg ms", "min ms", "max ms"),
    }
    for i = 1, #rows do
        local rec = rows[i]
        lines[#lines + 1] = format("  %-34s %-30s %-22s %8d   %10.2f   %10.2f   %8.3f   %8.3f   %8.3f",
            rec.callback, JitProfiler.compute_masked_name(rec.handler), JitProfiler.compute_masked_name(JitProfiler.get_owner(rec.handler)), rec.calls,
            rec.self_us / 1000.0, rec.total_us / 1000.0, rec.avg_us / 1000.0, rec.min_us / 1000.0, rec.max_us / 1000.0)
    end
    local by_cb = {}
    for i = 1, #rows do by_cb[rows[i].callback] = (by_cb[rows[i].callback] or 0) + rows[i].self_us end
    local cb_rows = sort_entries(by_cb)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- BY CALLBACK   own ms summed across handlers " .. string.rep("-", 40)
    for i = 1, #cb_rows do
        lines[#lines + 1] = format("  %-40s %10.2f ms own", cb_rows[i][1], cb_rows[i][2] / 1000.0)
    end
    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_callbacks_" .. stamp .. ".txt"), lines)
    log("JitProfiler/callbacks: report -> %s", tostring(report_path))
    return {
        kind = KIND_CALLBACKS, rows = rows, total_us = total_self,
        meta = { wrapped = wrapped, duration = duration_sec, stamp = stamp },
    }
end

-- FRAME report: per-render-frame timing. Metrics, the hitch list, and the inter-hitch rhythm, all over the full series.
function write_frame(series, opts)
    local frames = #series
    local t0, duration_sec = opts.t0, opts.duration
    local gate_k, floor_ms = opts.gate_k, opts.floor_ms

    local sorted, sum = {}, 0
    for i = 1, frames do sorted[i] = series[i]; sum = sum + series[i] end
    table.sort(sorted)
    local mean = frames > 0 and sum / frames or 0
    local median = frames > 0 and sorted[mceil(frames / 2)] or 0
    local min_ms = frames > 0 and sorted[1] or 0
    local max_ms = frames > 0 and sorted[frames] or 0
    local p95 = compute_percentile(sorted, 95)
    local p99 = compute_percentile(sorted, 99)
    local low1 = compute_low_mean(sorted, 0.01)
    local low01 = frames >= FRAME_MIN_FRAMES_FOR_P999 and compute_low_mean(sorted, 0.001) or nil
    local effective_gate = median * gate_k > floor_ms and median * gate_k or floor_ms

    local hitches = compute_frame_hitches(series, t0, median, gate_k, floor_ms)
    local hitch_time = 0
    for i = 1, #hitches do hitch_time = hitch_time + hitches[i].dt end
    local rhythm = compute_frame_rhythm(hitches)
    local dist = compute_frame_dist(series)

    local ranked = {}
    for i = 1, #hitches do ranked[i] = hitches[i] end
    table.sort(ranked, function(left, right) return left.dt > right.dt end)

    local metrics = { n = frames, mean = mean, median = median, min = min_ms, max = max_ms,
                      p95 = p95, p99 = p99, low1 = low1, low01 = low01,
                      fps_median = median > 0 and 1000 / median or 0,
                      hitch_count = #hitches, hitch_time = hitch_time, gate = effective_gate, dist = dist }

    local lines = {
        RULE,
        "  JitProfiler  -  HITCHES   per-render-frame time (device().time_delta, raw and unclamped)",
        format("  modded_exes %s   |   %d frames   |   ~%.0f s   |   median %.1f ms (%.0f fps)",
            tostring(_G.MODDED_EXES_VERSION or "?"), frames, duration_sec, median, metrics.fps_median),
        RULE,
        "",
        format("  median %.1f ms   mean %.1f ms   min %.1f ms   max %.1f ms", median, mean, min_ms, max_ms),
        format("  p95 %.1f ms   p99 %.1f ms   1%% low %.1f ms%s", p95, p99, low1,
            low01 and format("   0.1%% low %.1f ms", low01) or "   (0.1% low needs a longer capture)"),
        format("  hitches %d over %.0f ms total   |   gate %.1f ms (dt > %.1fx median AND > %.0f ms)",
            #hitches, hitch_time, effective_gate, gate_k, floor_ms),
    }
    if opts.truncated then lines[#lines + 1] = format("  NOTE series capped at %d frames; capture auto-stopped, the tail was not recorded", frames) end
    if opts.dropped and opts.dropped > 0 then lines[#lines + 1] = format("  NOTE %d frame(s) the heartbeat skipped (device().frame gap)", opts.dropped) end
    lines[#lines + 1] = ""
    if #rhythm > 0 then
        lines[#lines + 1] = "-- RHYTHM   seconds between consecutive hitches " .. string.rep("-", 40)
        for i = 1, math.min(#rhythm, 3) do
            lines[#lines + 1] = format("  a hitch every ~%d s   (%d times)", rhythm[i].sec, rhythm[i].count)
        end
    else
        lines[#lines + 1] = format("-- RHYTHM   too few hitches (%d) to read a period", #hitches)
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- HITCHES   worst frames, ranked by frame time " .. string.rep("-", 40)
    lines[#lines + 1] = format("  %8s   %10s   %12s", "FRAME", "dt ms", "at ~s")
    for i = 1, math.min(#ranked, 50) do
        local hitch = ranked[i]
        lines[#lines + 1] = format("  %8d   %10.1f   %12.1f", hitch.index, hitch.dt, (hitch.wall - t0) / 1000)
    end

    local stamp = get_timestamp()
    local report_path = write_lines(build_log_path("jitprofiler_frame_" .. stamp .. ".txt"), lines)
    log("JitProfiler/frame: report -> %s", tostring(report_path))
    return {
        kind = KIND_FRAME,
        series = compute_downsample(series, FRAME_CHART_COLUMNS),
        metrics = metrics, hitches = ranked, rhythm = rhythm,
        meta = { frames = frames, duration = duration_sec, stamp = stamp,
                 gate = effective_gate, truncated = opts.truncated, dropped = opts.dropped },
    }
end

-- The machine-readable per-kind capture written to $logs$; names honour the live anon setting.
function write_json(capture)
    if not capture then return end
    local doc = build_capture_doc(capture)
    doc.schema_version = 1
    doc.tool = "JitProfiler"
    doc.mod_version = _jitprofiler_manifest.MANIFEST.version
    local path = build_log_path("jitprofiler_" .. capture.kind .. "_" .. capture.meta.stamp .. ".json")
    if not xfs.write_file(path, format_json(doc)) then log("!JitProfiler: cannot write %s", tostring(path)) end
end

-- The combined page payload: every retained capture under one doc, masked, for the viewer page.
--- @param captures table retained captures keyed by kind (any subset of cpu/mem/scan/callbacks)
--- @param stamp string the generation timestamp
--- @return string the JSON the viewer template embeds
function build_page_json(captures, stamp)
    local combined = { tool = "JitProfiler", mod_version = _jitprofiler_manifest.MANIFEST.version,
                       generated = stamp, captures = {} }
    for kind, cap in pairs(captures) do combined.captures[kind] = build_capture_doc(cap) end
    return format_json(combined)
end

-- Callers (toward root) and callees (toward leaf) of a frame, summed across a retained sampling capture's leaf-first stacks.
function compute_neighbors(cap, frame)
    if not (cap and frame and cap.by_stack) then return nil end
    local out = { callers = {}, callees = {} }
    for stack, weight in pairs(cap.by_stack) do
        collect_neighbors({ stack = stack, weight = weight }, frame, out)
    end
    return { callers = sort_entries(out.callers), callees = sort_entries(out.callees) }
end

--- Write the hitch frames' stacks of a HITCHES capture as a SpeedScope .folded, the same raw dump CPU and MEM get.
--- @return string|nil the written path
function write_hitch_folded(stamp, by_stack)
    local path = write_folded("hitches_" .. stamp, by_stack)
    log("JitProfiler/frame: hitch flamegraph -> %s (speedscope.app)", tostring(path))
    return path
end

--- @return table|nil { callers, callees } of a scanned function from a retained instrumentation capture's call graph, or nil.
function compute_scan_neighbors(cap, key)
    if not (cap and cap.edges and key) then return nil end
    local callers, callees = collect_edge_neighbors(cap.edges, key)
    return { callers = callers, callees = callees }
end

--- COST rows over a capture's stacks: every sample lands on one row, as Own on a mod Self frame or on the vanilla row when no mod entry exists.
--- Otherwise the first mod frame toward the root that was called to do a job takes it as Caused; patches and hooks are passed over and noted.
--- @return table sorted { key, owner, own, caused, total, hook, caused_by = sorted {leaf, weight}, via = sorted {name, weight} }
function compute_cost_rows(by_stack)
    local get_owner, get_short = JitProfiler.get_owner, JitProfiler.get_short_frame
    local on_stack, total = {}, 0
    for stack, weight in pairs(by_stack) do
        total = total + weight
        local seen = {}
        for frame in string.gmatch(stack, "[^;]+") do
            local short = get_short(frame)
            if not seen[short] then seen[short] = true; on_stack[short] = (on_stack[short] or 0) + weight end
        end
    end
    local function is_hook(short)
        return is_mod_owner(get_owner(short)) and compute_pct(on_stack[short] or 0, total) >= WRAPPER_SHARE
    end
    local rows = {}
    local function get_row(short)
        local row = rows[short]
        if not row then
            row = { key = short, owner = get_owner(short), own = 0, caused = 0, hook = is_hook(short), caused_by = {}, via = {} }
            rows[short] = row
        end
        return row
    end
    for stack, weight in pairs(by_stack) do collect_stack_cost(stack, weight, get_row, is_hook) end
    local list = {}
    for _, row in pairs(rows) do
        row.total = row.own + row.caused
        row.caused_by = sort_entries(row.caused_by)
        row.via = sort_entries(row.via)
        list[#list + 1] = row
    end
    table.sort(list, function(left, right) return left.total > right.total end)
    return list
end
